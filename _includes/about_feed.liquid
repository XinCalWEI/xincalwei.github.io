{% comment %}
  Dated rows for the News archive (/news/): mono date column, category tag,
  serif title, one-line dek and, from 768px, a small thumbnail. Each row is one
  block-level link. (The homepage now builds its own list in _includes/home/.)

  Params:
    items   — a collection, already ordered newest first
    limit   — integer (default 5)
    kind    — 'news' | 'posts'
    excerpt — true: show a one-line dek (description, else the opening text)
              and the thumbnail
{% endcomment %}

{% assign feed_limit = include.limit | default: 5 %}
{% assign feed_count = include.items | size %}

{% if feed_count > 0 %}
  <ol class="feed">
    {% for item in include.items limit: feed_limit %}
      {% assign is_external = false %}
      {% assign href = item.url | relative_url %}
      {% if item.redirect != blank %}
        {% if item.redirect contains '://' %}
          {% assign href = item.redirect %}
          {% assign is_external = true %}
        {% else %}
          {% assign href = item.redirect | relative_url %}
        {% endif %}
      {% endif %}
      <li>
        {% if include.kind == 'news' and item.inline %}
          <div class="feed__row">
            <time class="feed__date" datetime="{{ item.date | date_to_xmlschema }}">{{ item.date | date: '%-d %b %Y' }}</time>
            <span class="feed__body">
              <span class="feed__title">{{ item.content | remove: '<p>' | remove: '</p>' | emojify }}</span>
            </span>
          </div>
        {% else %}
          <a
            class="feed__row"
            href="{{ href }}"
            {% if is_external %}
              target="_blank"
              rel="noopener noreferrer"
            {% endif %}
          >
            <time class="feed__date" datetime="{{ item.date | date_to_xmlschema }}">{{ item.date | date: '%-d %b %Y' }}</time>
            <span class="feed__body">
              {% if include.kind == 'posts' %}
                {% assign cat = item.categories | first %}
                {% if cat %}
                  <span class="tag feed__tag">{{ cat | replace: '-', ' ' }}</span>
                {% endif %}
              {% elsif include.excerpt and item.category %}
                <span class="tag feed__tag">{{ item.category }}</span>
              {% endif %}
              <span class="feed__title">
                {{- item.title -}}
                {%- if is_external %}
                  {% include icon.liquid name="arrow-up-right" class="feed__ext" -%}
                  <span class="sr-only">(opens in a new tab)</span>
                {% endif -%}
              </span>
              {% if item.description != blank %}
                {% if include.kind == 'posts' or include.excerpt %}
                  <span class="feed__desc">{{ item.description | strip_html | strip }}</span>
                {% endif %}
              {% elsif include.excerpt and item.content != blank %}
                {% comment %} the '</'→' </' replace keeps words from running together across block boundaries after strip_html {% endcomment %}
                <span class="feed__desc">{{ item.content | replace: '</', ' </' | strip_html | strip_newlines | replace: '  ', ' ' | replace: ' .', '.' | replace: ' ,', ',' | truncate: 200 }}</span>
              {% endif %}
            </span>
            {% if include.excerpt and item.thumbnail %}
              <span class="feed__thumb{% if item.thumbnail_fit == 'contain' %} feed__thumb--contain{% endif %}">
                {% include figure.liquid path=item.thumbnail sizes="160px" width="160" height="107" alt="" %}
              </span>
            {% endif %}
          </a>
        {% endif %}
      </li>
    {% endfor %}
  </ol>
{% else %}
  <p class="feed__empty">Nothing here yet.</p>
{% endif %}
