{% if site.bib_search %}
  <script src="{{ '/assets/js/bibsearch.js' | relative_url | bust_file_cache }}" type="module"></script>
  <div class="bibsearch">
    <label class="sr-only" for="bibsearch">Filter publications</label>
    <input type="search" id="bibsearch" spellcheck="false" autocomplete="off" class="search bibsearch-form-input" placeholder="Filter by title, author, venue, year">
  </div>
{% endif %}
