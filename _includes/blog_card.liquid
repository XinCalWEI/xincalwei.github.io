{% assign blog_post = include.post %}
{% assign primary_category = blog_post.categories | first %}
{% assign category_label = blog_post.categories | join: ' · ' | replace: '-', ' ' %}
{% assign primary_tag = blog_post.tags | first %}

{% if blog_post.external_source == blank %}
  {% assign word_count = blog_post.content | number_of_words %}
{% else %}
  {% assign word_count = blog_post.feed_content | strip_html | number_of_words %}
{% endif %}
{% assign read_time = word_count | plus: 179 | divided_by: 180 %}

{% assign card_href = blog_post.url | relative_url %}
{% assign is_external = false %}
{% if blog_post.redirect != blank %}
  {% if blog_post.redirect contains '://' %}
    {% assign card_href = blog_post.redirect %}
    {% assign is_external = true %}
  {% else %}
    {% assign card_href = blog_post.redirect | relative_url %}
  {% endif %}
{% endif %}

{% capture card_categories %}{% for category in blog_post.categories %}{{ category | slugify }} {% endfor %}{% endcapture %}
{% capture card_tags %}{% for tag in blog_post.tags %}{{ tag | slugify }} {% endfor %}{% endcapture %}
{% capture card_search %}{{ blog_post.title }} {{ blog_post.description }} {{ blog_post.categories | join: ' ' }} {{ blog_post.tags | join: ' ' }} {{ blog_post.card_status }}{% endcapture %}

<a
  class="blog-card{% if include.featured %} blog-card--featured{% endif %}{% if include.solo %} blog-card--solo{% endif %}{% if include.tail %} blog-card--tail{% endif %}"
  href="{{ card_href }}"
  data-cats="{{ card_categories | strip }}"
  data-tags="{{ card_tags | strip }}"
  data-search="{{ card_search | strip_html | strip_newlines | downcase | escape }}"
  {% if include.tail %}
    data-tail="true"
  {% endif %}
  {% if is_external %}
    target="_blank" rel="noopener noreferrer"
  {% endif %}
>
  <div
    class="blog-card__media{% if primary_category %} blog-card__media--{{ primary_category | slugify }}{% endif %}{% if blog_post.thumbnail_fit == 'contain' %} blog-card__media--contain{% elsif blog_post.thumbnail_fit == 'wide' %} blog-card__media--wide{% endif %}{% if blog_post.thumbnail_position == 'top' %} blog-card__media--top{% endif %}"
  >
    {% if blog_post.thumbnail %}
      {% if include.featured or include.priority %}
        {% include figure.liquid loading="eager" fetchpriority="high" path=blog_post.thumbnail sizes="(min-width: 992px) 580px, (min-width: 768px) 52vw, 100vw" alt="" %}
      {% else %}
        {% include figure.liquid loading="lazy" path=blog_post.thumbnail sizes="(min-width: 992px) 500px, (min-width: 768px) 46vw, 100vw" alt="" %}
      {% endif %}
    {% else %}
      <span class="blog-card__ph" aria-hidden="true">
        <span class="blog-card__ph-orbit"></span>
        <span class="tiles"><span></span><span></span><span></span><span></span></span>
        <span class="blog-card__ph-label">
          {% if category_label != blank %}{{ category_label }}{% else %}Field note{% endif %}
        </span>
      </span>
    {% endif %}
  </div>

  <div class="blog-card__body">
    <div class="blog-card__topline">
      {% if category_label != blank %}
        <span class="feed__pill feed__pill--{{ primary_category | slugify }}">{{ category_label }}</span>
      {% endif %}
      {% if primary_tag %}
        <span class="blog-card__topic" title="{{ primary_tag | escape }}"
          ><i class="fa-solid fa-hashtag" aria-hidden="true"></i>{{ primary_tag -}}
        </span>
      {% endif %}
      {% if blog_post.card_status %}
        <span class="blog-card__status">{{ blog_post.card_status }}</span>
      {% endif %}
      {% if include.latest %}
        <span class="blog-card__latest"><span aria-hidden="true"></span>Latest</span>
      {% endif %}
    </div>

    <h2 class="blog-card__title">{{ blog_post.title }}</h2>
    {% if blog_post.description %}
      <p class="blog-card__desc">{{ blog_post.description }}</p>
    {% endif %}

    <p class="blog-card__meta">
      <time datetime="{{ blog_post.date | date_to_xmlschema }}">{{ blog_post.date | date: '%b %-d, %Y' }}</time>
      <span class="blog-card__meta-dot" aria-hidden="true"></span>
      <span>{{ read_time }} min read</span>
      <span class="blog-card__arrow" aria-hidden="true">
        <i class="fa-solid {% if is_external %}fa-arrow-up-right-from-square{% else %}fa-arrow-right{% endif %}"></i>
      </span>
    </p>
    {% if is_external -%}
      <span class="sr-only">Opens in a new tab</span>
    {%- endif %}
  </div>
</a>
