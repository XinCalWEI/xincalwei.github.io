{% comment %}
  One post card for the Blog index and the blog archives.
  Params: post, featured (lead story), latest, solo, tail, priority (eager image).
  Hooks read by assets/js/blog-filter.js: .blog-card, data-cats, data-tags,
  data-search, data-tail, and the --featured / --tail / --solo modifiers.
{% endcomment %}
{% assign blog_post = include.post %}
{% assign primary_category = blog_post.categories | first %}
{% assign category_label = primary_category | replace: '-', ' ' | capitalize %}
{% for taxonomy_category in site.data.blog_taxonomy.categories %}
  {% if taxonomy_category.key == primary_category %}{% assign category_label = taxonomy_category.label %}{% endif %}
{% endfor %}
{% assign primary_tag = blog_post.tags | first %}

{% if blog_post.external_source == blank %}
  {% assign word_count = blog_post.content | strip_html | number_of_words %}
{% else %}
  {% assign word_count = blog_post.feed_content | strip_html | number_of_words %}
{% endif %}
{% assign read_time = word_count | plus: 179 | divided_by: 180 %}

{% assign card_href = blog_post.url | relative_url %}
{% assign is_external = false %}
{% if blog_post.redirect != blank %}
  {% if blog_post.redirect contains '://' %}
    {% assign card_href = blog_post.redirect %}
    {% assign is_external = true %}
  {% else %}
    {% assign card_href = blog_post.redirect | relative_url %}
  {% endif %}
{% endif %}

{% capture card_categories %}{% for category in blog_post.categories %}{{ category | slugify }} {% endfor %}{% endcapture %}
{% capture card_tags %}{% for tag in blog_post.tags %}{{ tag | slugify }} {% endfor %}{% endcapture %}
{% capture card_search %}{{ blog_post.title }} {{ blog_post.description }} {{ blog_post.categories | join: ' ' }} {{ blog_post.tags | join: ' ' }} {{ blog_post.card_status }}{% endcapture %}

<a
  class="blog-card{% if include.featured %} blog-card--featured{% endif %}{% if include.solo %} blog-card--solo{% endif %}{% if include.tail %} blog-card--tail{% endif %}{% if blog_post.card_status %} blog-card--pending{% endif %}"
  href="{{ card_href }}"
  data-cats="{{ card_categories | strip }}"
  data-tags="{{ card_tags | strip }}"
  data-search="{{ card_search | strip_html | strip_newlines | downcase | escape }}"
  {% if include.tail %}
    data-tail="true"
  {% endif %}
  {% if is_external %}
    target="_blank" rel="noopener noreferrer"
  {% endif %}
>
  <div class="blog-card__media{% if blog_post.thumbnail_fit == 'contain' %} blog-card__media--contain{% elsif blog_post.thumbnail_fit == 'wide' %} blog-card__media--wide{% endif %}{% if blog_post.thumbnail_position == 'top' %} blog-card__media--top{% endif %}">
    {% if blog_post.thumbnail %}
      {% if include.featured or include.priority %}
        {% include figure.liquid loading="eager" fetchpriority="high" path=blog_post.thumbnail sizes="(min-width: 1120px) 600px, (min-width: 768px) 55vw, 100vw" width="1600" height="900" alt="" %}
      {% else %}
        {% include figure.liquid loading="lazy" path=blog_post.thumbnail sizes="(min-width: 1120px) 540px, (min-width: 768px) 48vw, 100vw" width="1600" height="900" alt="" %}
      {% endif %}
    {% else %}
      {% comment %} No image yet: a plate of the contour motif, not a fake illustration {% endcomment %}
      <span class="blog-card__ph" aria-hidden="true"><span class="contour-field"></span></span>
    {% endif %}
  </div>

  <div class="blog-card__body">
    <p class="blog-card__topline">
      {% if primary_category %}
        <span class="tag">{{ category_label }}</span>
      {% endif %}
      {% if primary_tag %}
        <span class="blog-card__topic">{{ primary_tag }}</span>
      {% endif %}
      {% if blog_post.card_status %}
        <span class="tag tag--earth blog-card__status">{{ blog_post.card_status }}</span>
      {% elsif include.latest %}
        <span class="blog-card__latest">Latest</span>
      {% endif %}
    </p>

    <h2 class="blog-card__title">{{ blog_post.title }}</h2>
    {% if blog_post.description %}
      <p class="blog-card__desc">{{ blog_post.description }}</p>
    {% endif %}

    <p class="blog-card__meta">
      <time datetime="{{ blog_post.date | date_to_xmlschema }}">{{ blog_post.date | date: '%-d %b %Y' }}</time>
      {%- unless blog_post.card_status %}<span aria-hidden="true"> · </span>{{ read_time }} min read{% endunless -%}
      {%- if is_external %}<span class="sr-only"> (opens in a new tab)</span>{% endif -%}
    </p>
  </div>
</a>
