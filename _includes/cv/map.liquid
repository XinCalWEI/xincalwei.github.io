{% comment %}
  Key/value block. `style: cards` (References) renders a grid of contact cards;
  otherwise a definition list in the entry column.
{% endcomment %}
{% if entry.style == 'cards' %}
  <ul class="cv-cards">
    {% for content in entry.contents %}
      <li class="cv-card">
        <h3 class="cv-card__name" data-toc-skip>{{ content.name }}</h3>
        {% if content.value %}
          <p class="cv-card__text">{{ content.value }}</p>
        {% endif %}
        {% if content.links %}
          <p class="cv-row__links">
            {% for item in content.links %}
              {% if item.link %}
                <a class="text-link" href="{{ item.link }}">{{ item.name | default: 'Document' }}</a>
              {% endif %}
            {% endfor %}
          </p>
        {% endif %}
      </li>
    {% endfor %}
  </ul>
{% else %}
  <dl class="cv-map">
    {% for content in entry.contents %}
      <div class="cv-map__row">
        <dt>{{ content.name }}</dt>
        <dd>
          {{ content.value }}
          {% if content.links %}
            {% for item in content.links %}
              {% if item.link %}
                <a class="text-link" href="{{ item.link }}">{{ item.name | default: 'Document' }}</a>
              {% endif %}
            {% endfor %}
          {% endif %}
        </dd>
      </div>
    {% endfor %}
  </dl>
{% endif %}
