{% comment %} Mentees by program, from the People page front matter (_pages/profiles.md). {% endcomment %}
{% assign people_page = site.pages | where: 'permalink', '/people/' | first %}
<ol class="cv-rows">
  {% assign open = false %}
  {% for profile in people_page.profiles %}
    {% if profile.section_title %}
      {% if open %}
            </ul>
          </div>
        </li>
      {% endif %}
      <li class="cv-row">
        <div class="cv-row__body">
          <h3 class="cv-row__title" data-toc-skip>{{ profile.section_title }}</h3>
          <ul class="cv-notes">
      {% assign open = true %}
    {% elsif open %}
      <li>
        <strong class="cv-person">{{ profile.name }}</strong>
        {%- if profile.more_info %}, {{ profile.more_info | replace: '<br>', ', ' | strip_html | strip_newlines | strip }}{% endif %}
      </li>
    {% endif %}
  {% endfor %}
  {% if open %}
          </ul>
        </div>
      </li>
  {% endif %}
</ol>
