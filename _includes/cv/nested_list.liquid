{% comment %} Titled groups (e.g. Academic Service): an h3 per group, its items below. {% endcomment %}
<ol class="cv-rows">
  {% for content in entry.contents %}
    <li class="cv-row">
      <div class="cv-row__body">
        <h3 class="cv-row__title" data-toc-skip>{{ content.title }}</h3>
        {% if content.items %}
          <ul class="cv-notes">
            {% for subitem in content.items %}
              <li>{{ subitem }}</li>
            {% endfor %}
          </ul>
        {% endif %}
      </div>
    </li>
  {% endfor %}
</ol>
