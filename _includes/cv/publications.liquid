{% comment %}
  Publications, generated from _bibliography/papers.bib (the same source as
  /publications/) as compact APA citations (template: _layouts/cv-bib.liquid),
  newest first. jekyll-scholar tags cannot sort per call (sort_by is global
  config), so each type is queried year by year; empty years render an empty
  list that the stylesheet hides.
{% endcomment %}
{%- capture cv_n_articles -%}{% bibliography_count --query @article %}{%- endcapture -%}
{%- capture cv_n_conf -%}{% bibliography_count --query !@article %}{%- endcapture -%}
{%- assign cv_last_year = site.time | date: '%Y' | plus: 1 -%}
<p class="cv-pubs__summary">
  <span class="mono">{{ cv_n_articles | strip }} journal articles · {{ cv_n_conf | strip }} conference papers &amp; presentations</span>
</p>
<h3 class="cv-sub" data-toc-skip>Journal articles</h3>
<div class="cv-pubs">
  {% for cv_year in (2010..cv_last_year) reversed %}
    {% bibliography --query @article[year={{ cv_year }}] --template cv-bib --group_by none %}
  {% endfor %}
</div>
<h3 class="cv-sub" data-toc-skip>Conference papers &amp; presentations</h3>
<div class="cv-pubs">
  {% for cv_year in (2010..cv_last_year) reversed %}
    {% bibliography --query @inproceedings[year={{ cv_year }}] --template cv-bib --group_by none %}
    {% bibliography --query @misc[year={{ cv_year }}] --template cv-bib --group_by none %}
  {% endfor %}
</div>
