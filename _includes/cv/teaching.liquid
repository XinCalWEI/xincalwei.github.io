{% comment %} Courses by institution, from _data/teaching.yml (also renders /teaching/). {% endcomment %}
<ol class="cv-rows">
  {% for school in site.data.teaching %}
    <li class="cv-row">
      <div class="cv-row__body">
        <h3 class="cv-row__title" data-toc-skip>{{ school.institution }}</h3>
        <ul class="cv-notes">
          {% for course in school.courses %}
            <li>{{ course.title }}</li>
          {% endfor %}
        </ul>
      </div>
    </li>
  {% endfor %}
</ol>
