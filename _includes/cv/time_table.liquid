{% comment %}
  CV timeline rows: years in a mono column on the left (from 768px), the entry on
  the right. Rows with a `title` get an h3 (kept out of the TOC); rows with only
  `items` (awards, memberships) list them as the entry text.
{% endcomment %}
<ol class="cv-rows">
  {% for content in entry.contents %}
    <li class="cv-row">
      {% if content.year %}
        <p class="cv-row__when">{{ content.year | replace: ' - ', '–' }}</p>
      {% endif %}
      <div class="cv-row__body">
        {% if content.title %}
          <h3 class="cv-row__title" data-toc-skip>{{ content.title }}</h3>
        {% endif %}
        {% if content.institution or content.department %}
          <p class="cv-row__where">
            {{- content.institution -}}
            {%- if content.institution and content.department %} · {% endif -%}
            {{- content.department -}}
          </p>
        {% endif %}
        {% if content.location %}
          <p class="cv-row__loc">{{ content.location }}</p>
        {% endif %}
        {% if content.maindescription %}
          <div class="cv-row__text">{{ content.maindescription }}</div>
        {% endif %}
        {% for group in (1..2) %}
          {% if group == 1 %}
            {% assign rows = content.description %}
          {% else %}
            {% assign rows = content.items %}
          {% endif %}
          {% if rows %}
            <ul class="{% if content.title or group == 1 %}cv-notes{% else %}cv-items{% endif %}">
              {% for item in rows %}
                <li>
                  {% if item.contents %}
                    {{ item.title }}
                    <ul class="cv-notes">
                      {% for subitem in item.contents %}
                        <li>{{ subitem }}</li>
                      {% endfor %}
                    </ul>
                  {% else %}
                    {{ item }}
                  {% endif %}
                </li>
              {% endfor %}
            </ul>
          {% endif %}
        {% endfor %}
        {% if content.linkitems %}
          <p class="cv-row__links">
            {% for item in content.linkitems %}
              {% if item.link %}
                <a class="text-link" href="{{ item.link }}">{{ item.linkname | default: 'Document' }}</a>
              {% endif %}
            {% endfor %}
          </p>
        {% endif %}
      </div>
    </li>
  {% endfor %}
</ol>
