{% assign img_path = include.path | remove: '.jpg' | remove: '.jpeg' | remove: '.png' | remove: '.tiff' | remove: '.gif' %}
{% assign parts = include.path | split: '.' %}
{% assign ext = parts.last %}

<figure
  {% if include.slot %}
    slot="{{ include.slot }}"
  {% endif %}
>
  <picture>
    <!-- Auto scaling with imagemagick -->
    <!--
      See https://www.debugbear.com/blog/responsive-images#w-descriptors-and-the-sizes-attribute and
      https://developer.mozilla.org/en-US/docs/Learn/HTML/Multimedia_and_embedding/Responsive_images for info on defining 'sizes' for responsive images
    -->
    {% if site.imagemagick.enabled %}
      {% unless include.avoid_scaling %}
        <source
          class="responsive-img-srcset"
          {% if ext == 'gif' or ext == 'jpeg' or ext == 'jpg' or ext == 'png' or ext == 'tiff' %}
            srcset="{% for i in site.imagemagick.widths %}{{ img_path | relative_url | replace: ' ', '%20' | replace: ',', '%2C' }}-{{ i }}.webp {{ i }}w,{% endfor %}"
            type="image/webp"
          {% else %}
            srcset="{{ include.path | relative_url | replace: ' ', '%20' | replace: ',', '%2C' }}"
          {% endif %}
          {% comment %}
            Default sizes: a figure in the reading column is at most ~736px wide
            (the article width), so 1x desktop screens fetch the 800w file and 2x
            screens the 1400w. Callers showing an image wider or narrower than
            that (heroes, grids, thumbnails) pass their own `sizes`.
          {% endcomment %}
          {% if include.sizes %}
            sizes="{{ include.sizes }}"
          {% else %}
            sizes="(min-width: 800px) 736px, 95vw"
          {% endif %}
        >
      {% endunless %}
    {% endif %}
    {% comment %}
      width/height are only emitted when the caller passes real values (the
      intrinsic pixel size, so the browser reserves the aspect ratio). Without
      them the image fills its figure via CSS (ds/_base: figure picture > img).
      "100%"/"auto" are not valid attribute values and are dropped.
    {% endcomment %}
    <img
      src="{% if include.url %}{{ include.url }}{% elsif include.cache_bust %}{{ include.path | relative_url | bust_file_cache }}{% else %}{{ include.path | relative_url }}{% endif %}"
      {% if include.class %}
        class="{{ include.class }}"
      {% endif %}
      {% if include.width and include.width != '100%' and include.width != 'auto' %}
        width="{{ include.width }}"
      {% endif %}
      {% if include.height and include.height != 'auto' and include.height != '100%' %}
        height="{{ include.height }}"
      {% endif %}
      {% if include['min-width'] or include['min-height'] or include['max-width'] or include['max-height'] %}
        style="
          {% if include['min-width'] %}
            min-width: {{ include.min-width }};
          {% endif %}
          {% if include['min-height'] %}
            min-height: {{ include.min-height }};
          {% endif %}
          {% if include['max-width'] %}
            max-width: {{ include.max-width }};
          {% endif %}
          {% if include['max-height'] %}
            max-height: {{ include.max-height }};
          {% endif %}
        "
      {% endif %}
      alt="{{ include.alt | default: '' | escape }}"
      {% if include.title %}
        title="{{ include.title | escape }}"
      {% endif %}
      {% if include.zoomable %}
        data-zoomable
      {% endif %}
      {% if include.loading %}
        loading="{{ include.loading }}"
      {% elsif site.lazy_loading_images %}
        loading="lazy"
      {% endif %}
      {% if include.fetchpriority %}
        fetchpriority="{{ include.fetchpriority }}"
      {% endif %}
      onerror="this.onerror=null; $('.responsive-img-srcset').remove();"
    >
  </picture>

  {% if include.caption %}
    <figcaption class="caption">{{ include.caption }}</figcaption>
  {% endif %}
</figure>
