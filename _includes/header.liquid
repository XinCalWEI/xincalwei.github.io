<header class="site-header">
  {% comment %}
    JS contracts (see assets/js): #navbar (progress-bar.js measures it), the Bootstrap
    collapse wiring on .navbar-toggler / #navbarNav, #search-toggle .nav-link
    (shortcut-key.js updates its <kbd>), and #light-toggle with the three
    #light-toggle-* children (theme.js + _sass/_themes.scss).
  {% endcomment %}
  <nav id="navbar" class="navbar navbar-light navbar-expand-lg {% if site.navbar_fixed %}fixed-top{% else %}sticky-top{% endif %}" aria-label="Primary">
    <div class="container container--wide">
      <a class="navbar-brand" href="{{ '/' | relative_url }}" {% if page.url == '/' %}aria-current="page"{% endif %}>
        {%- if site.title == 'blank' -%}
          {{- site.first_name -}}
          {%- if site.middle_name %} {{ site.middle_name }}{% endif %} {{ site.last_name -}}
        {%- else -%}
          {{- site.title -}}
        {%- endif -%}
      </a>

      <button
        class="navbar-toggler collapsed"
        type="button"
        data-toggle="collapse"
        data-target="#navbarNav"
        aria-controls="navbarNav"
        aria-expanded="false"
        aria-label="Menu"
      >
        <span class="icon-bar top-bar"></span>
        <span class="icon-bar middle-bar"></span>
        <span class="icon-bar bottom-bar"></span>
      </button>

      <div class="collapse navbar-collapse" id="navbarNav">
        <ul class="navbar-nav">
          {% assign sorted_pages = site.pages | sort: 'nav_order' %}
          {% for p in sorted_pages %}
            {% if p.nav and p.autogen == null %}
              {% if p.dropdown %}
                {% assign has_active_child = false %}
                {% for child in p.children %}
                  {% if child.permalink and child.title != 'divider' %}
                    {% unless child.permalink contains '://' %}
                      {% if page.url contains child.permalink %}
                        {% assign has_active_child = true %}
                      {% endif %}
                    {% endunless %}
                  {% endif %}
                {% endfor %}
                {% assign dropdown_id = p.nav_title | default: p.title | slugify | prepend: 'nav-menu-' %}
                <li class="nav-item dropdown{% if has_active_child %} active{% endif %}">
                  <button
                    class="nav-link dropdown-toggle"
                    type="button"
                    id="{{ dropdown_id }}"
                    data-toggle="dropdown"
                    aria-haspopup="true"
                    aria-expanded="false"
                  >
                    {{- p.nav_title | default: p.title -}}
                    {%- include icon.liquid name="chevron-down" -%}
                  </button>
                  <div class="dropdown-menu dropdown-menu-right" aria-labelledby="{{ dropdown_id }}">
                    {% for child in p.children %}
                      {% if child.title == 'divider' %}
                        <div class="dropdown-divider"></div>
                      {% else %}
                        {% assign child_active = false %}
                        {% unless child.permalink contains '://' %}
                          {% if page.url contains child.permalink %}{% assign child_active = true %}{% endif %}
                        {% endunless %}
                        <a
                          class="dropdown-item{% if child_active %} active{% endif %}"
                          href="{% if child.permalink contains '://' %}{{ child.permalink }}{% else %}{{ child.permalink | relative_url }}{% endif %}"
                          {% if child_active and page.url == child.permalink %}
                            aria-current="page"
                          {% endif %}
                        >
                          {{- child.title -}}
                        </a>
                      {% endif %}
                    {% endfor %}
                  </div>
                </li>
              {% else %}
                {%- if p.permalink contains '://' -%}
                  {%- assign url = p.permalink -%}
                {%- elsif p.permalink contains '/blog/' -%}
                  {%- assign url = '/blog/' -%}
                {%- else -%}
                  {%- assign url = p.url -%}
                {%- endif -%}
                {% assign parent_link = p.permalink | remove: 'index.html' %}
                {% assign is_active = false %}
                {% if parent_link and page.url contains parent_link %}{% assign is_active = true %}{% endif %}
                <li class="nav-item{% if is_active %} active{% endif %}">
                  <a
                    class="nav-link"
                    href="{{ url | relative_url }}"
                    {% if is_active and page.url == url %}
                      aria-current="page"
                    {% endif %}
                  >
                    {{- p.nav_title | default: p.title -}}
                  </a>
                </li>
              {% endif %}
            {% endif %}
          {% endfor %}
        </ul>

        <ul class="navbar-nav navbar-tools">
          {% if site.search_enabled %}
            <li class="nav-item">
              <button id="search-toggle" class="nav-tool" type="button" aria-label="Search (Ctrl K)" title="Search (Ctrl K)" onclick="openSearchModal()">
                <span class="nav-link">
                  {%- include icon.liquid name="search" -%}
                  <span class="nav-tool__label" aria-hidden="true">Search</span>
                  <kbd class="nav-kbd" aria-hidden="true">Ctrl K</kbd>
                </span>
              </button>
            </li>
          {% endif %}
          {% if site.enable_darkmode %}
            <li class="nav-item toggle-container">
              <button id="light-toggle" class="nav-tool" type="button" title="Change color theme">
                <span id="light-toggle-system" class="theme-state">
                  {%- include icon.liquid name="theme-system" -%}
                  <span class="sr-only">Color theme: system (switch to light)</span>
                </span>
                <span id="light-toggle-light" class="theme-state">
                  {%- include icon.liquid name="theme-light" -%}
                  <span class="sr-only">Color theme: light (switch to dark)</span>
                </span>
                <span id="light-toggle-dark" class="theme-state">
                  {%- include icon.liquid name="theme-dark" -%}
                  <span class="sr-only">Color theme: dark (switch to system)</span>
                </span>
                <span class="nav-tool__label nav-tool__label--theme" aria-hidden="true">Theme</span>
              </button>
            </li>
          {% endif %}
        </ul>
      </div>
    </div>
  </nav>
  {% if site.enable_progressbar and page.collection == 'posts' %}
    <!-- Scrolling progress bar (blog posts only) -->
    <progress id="progress" value="0" aria-hidden="true"></progress>
  {% endif %}
</header>
