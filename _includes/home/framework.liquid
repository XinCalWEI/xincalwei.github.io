{% comment %}
  Research framework diagram (replaces the raster overview on the homepage).
  Two inline SVGs with the same topology: a wide strip (>= 992px) and a tall
  stack (< 992px); CSS shows one. Shapes and text take theme colours from
  classes in _sass/pages/_home.scss, so dark mode needs nothing extra.
  Topology: TerraMosaic / open data (thrust 03) feeds prospective modeling
  (01) and retrospective analysis (02), which exchange with the Data + AI
  core and lead toward resilient communities. Keep <desc> in sync.
{% endcomment %}
{%- assign fw = page.research.framework -%}
{%- capture fw_desc -%}
  TerraMosaic and open landslide data (thrust 03) feed two complementary lines of work. Prospective modeling (thrust 01) anticipates future hazards through susceptibility, hazard and early-warning models. Retrospective analysis (thrust 02) learns from past disasters by tracing impacts and cascading consequences. Both exchange insight with a shared core of data and AI grounded in geohazard science, and both lead toward more resilient communities through risk-informed mitigation, preparedness and infrastructure decisions.
{%- endcapture -%}
<figure class="home-fw">
  <svg
    class="home-fw__svg home-fw__svg--wide"
    width="1072"
    height="325"
    viewBox="0 0 1072 325"
    role="img"
    aria-labelledby="home-fw-wide-title home-fw-wide-desc"
  >
    <title id="home-fw-wide-title">Research framework</title>
    <desc id="home-fw-wide-desc">{{ fw_desc | strip }}</desc>
    <defs>
      <marker id="home-fw-wide-arrow" viewBox="0 0 8 8" refX="8" refY="4" markerWidth="8" markerHeight="8" markerUnits="userSpaceOnUse" orient="auto-start-reverse">
        <path class="home-fw-arrowhead" d="M0 0.5 L8 4 L0 7.5 z" />
      </marker>
    </defs>

    <!-- data layer -->
    <rect class="home-fw-band home-fw-band--data" x="0.5" y="0.5" width="1071" height="55" rx="4" />
    <text class="home-fw-num" x="20" y="33">03</text>
    <text class="home-fw-title home-fw-title--band" x="50" y="34">TerraMosaic · open landslide data</text>
    <text class="home-fw-detail" x="1052" y="33" text-anchor="end">Global inventories · standardized metadata</text>

    <path class="home-fw-wire" d="M162.5 56 V103" marker-end="url(#home-fw-wide-arrow)" />
    <path class="home-fw-wire" d="M909.5 56 V103" marker-end="url(#home-fw-wide-arrow)" />

    <!-- methods layer -->
    <rect class="home-fw-node" x="0.5" y="104.5" width="324" height="119" rx="4" />
    <text class="home-fw-num" x="20" y="134">01</text>
    <text class="home-fw-title" x="20" y="162">Prospective modeling</text>
    <text class="home-fw-sub" x="20" y="186">Anticipate future hazards</text>
    <text class="home-fw-detail" x="20" y="208">Susceptibility · hazard · early warning</text>

    <path class="home-fw-wire" d="M329 164 H369" marker-start="url(#home-fw-wide-arrow)" marker-end="url(#home-fw-wide-arrow)" />

    <rect class="home-fw-node home-fw-node--core" x="373.5" y="104.5" width="324" height="119" rx="4" />
    <text class="home-fw-label" x="393" y="134">Shared core</text>
    <text class="home-fw-title" x="393" y="162">Data + AI</text>
    <text class="home-fw-sub" x="393" y="186">Grounded in geohazard science</text>
    <text class="home-fw-detail" x="393" y="208">ML · generative AI · remote sensing</text>

    <path class="home-fw-wire" d="M702 164 H743" marker-start="url(#home-fw-wide-arrow)" marker-end="url(#home-fw-wide-arrow)" />

    <rect class="home-fw-node" x="747.5" y="104.5" width="324" height="119" rx="4" />
    <text class="home-fw-num" x="767" y="134">02</text>
    <text class="home-fw-title" x="767" y="162">Retrospective analysis</text>
    <text class="home-fw-sub" x="767" y="186">Learn from past disasters</text>
    <text class="home-fw-detail" x="767" y="208">Impacts · cascading consequences</text>

    <path class="home-fw-wire" d="M162.5 224 V268" marker-end="url(#home-fw-wide-arrow)" />
    <path class="home-fw-wire" d="M909.5 224 V268" marker-end="url(#home-fw-wide-arrow)" />

    <!-- outcome layer -->
    <rect class="home-fw-band home-fw-band--outcome" x="0.5" y="268.5" width="1071" height="55" rx="4" />
    <text class="home-fw-title home-fw-title--band" x="20" y="302">Toward more resilient communities</text>
    <text class="home-fw-detail home-fw-detail--outcome" x="1052" y="301" text-anchor="end">Risk-informed mitigation · preparedness · infrastructure decisions</text>
  </svg>

  <svg
    class="home-fw__svg home-fw__svg--tall"
    width="360"
    height="645"
    viewBox="0 0 360 645"
    role="img"
    aria-labelledby="home-fw-tall-title home-fw-tall-desc"
  >
    <title id="home-fw-tall-title">Research framework</title>
    <desc id="home-fw-tall-desc">{{ fw_desc | strip }}</desc>
    <defs>
      <marker id="home-fw-tall-arrow" viewBox="0 0 8 8" refX="8" refY="4" markerWidth="8" markerHeight="8" markerUnits="userSpaceOnUse" orient="auto-start-reverse">
        <path class="home-fw-arrowhead" d="M0 0.5 L8 4 L0 7.5 z" />
      </marker>
    </defs>

    <!-- data layer -->
    <rect class="home-fw-band home-fw-band--data" x="0.5" y="0.5" width="359" height="67" rx="4" />
    <text class="home-fw-num" x="16" y="29">03</text>
    <text class="home-fw-title home-fw-title--band" x="42" y="29">TerraMosaic · open landslide data</text>
    <text class="home-fw-detail" x="42" y="52">Global inventories · standardized metadata</text>

    <!-- left rail: data feeds 01 and 02 -->
    <path class="home-fw-wire" d="M10.5 68 V156 H26" marker-end="url(#home-fw-tall-arrow)" />
    <path class="home-fw-wire" d="M10.5 156 V476 H26" marker-end="url(#home-fw-tall-arrow)" />

    <!-- methods layer -->
    <rect class="home-fw-node" x="26.5" y="96.5" width="307" height="119" rx="4" />
    <text class="home-fw-num" x="44" y="124">01</text>
    <text class="home-fw-title" x="44" y="150">Prospective modeling</text>
    <text class="home-fw-sub" x="44" y="173">Anticipate future hazards</text>
    <text class="home-fw-detail" x="44" y="196">Susceptibility · hazard · early warning</text>

    <path class="home-fw-wire" d="M180 220 V252" marker-start="url(#home-fw-tall-arrow)" marker-end="url(#home-fw-tall-arrow)" />

    <rect class="home-fw-node home-fw-node--core" x="26.5" y="256.5" width="307" height="119" rx="4" />
    <text class="home-fw-label" x="44" y="284">Shared core</text>
    <text class="home-fw-title" x="44" y="310">Data + AI</text>
    <text class="home-fw-sub" x="44" y="333">Grounded in geohazard science</text>
    <text class="home-fw-detail" x="44" y="356">ML · generative AI · remote sensing</text>

    <path class="home-fw-wire" d="M180 380 V412" marker-start="url(#home-fw-tall-arrow)" marker-end="url(#home-fw-tall-arrow)" />

    <rect class="home-fw-node" x="26.5" y="416.5" width="307" height="119" rx="4" />
    <text class="home-fw-num" x="44" y="444">02</text>
    <text class="home-fw-title" x="44" y="470">Retrospective analysis</text>
    <text class="home-fw-sub" x="44" y="493">Learn from past disasters</text>
    <text class="home-fw-detail" x="44" y="516">Impacts · cascading consequences</text>

    <!-- right rail: 01 and 02 lead to the outcome -->
    <path class="home-fw-wire" d="M334 156 H349.5 V576" marker-end="url(#home-fw-tall-arrow)" />
    <path class="home-fw-wire" d="M334 476 H349.5" />

    <!-- outcome layer -->
    <rect class="home-fw-band home-fw-band--outcome" x="0.5" y="576.5" width="359" height="67" rx="4" />
    <text class="home-fw-title home-fw-title--band" x="16" y="605">Toward more resilient communities</text>
    <text class="home-fw-detail home-fw-detail--outcome" x="16" y="628">Mitigation · preparedness · infrastructure</text>
  </svg>

  <figcaption class="home-fw__caption">
    <span><span class="home-fw__fig">Fig. 1</span>{{ fw.caption }}</span>
    {% if fw.download %}
      <a class="text-link home-fw__download" href="{{ fw.download | relative_url }}" download>
        {{- fw.download_label -}}
      </a>
    {% endif %}
  </figcaption>
</figure>
