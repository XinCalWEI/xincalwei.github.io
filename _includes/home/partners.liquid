{% comment %}
  05 · Collaborators & support: a static logo grid on one paper panel (the
  panel stays light in dark mode so every logo keeps its own colours legible).
  Logos are lazy, carry their real pixel size, and use the 480w WebP that
  jekyll-imagemagick generates. Optical-size nudges are classes
  (.partner--wide / .partner--compact), never img[alt] selectors (PurgeCSS).
  Copy: page.partners.
{% endcomment %}
{%- assign head = page.sections.partners -%}
<section class="home-section home-partners" aria-labelledby="home-partners-title">
  <div class="section-head">
    <p class="kicker">
      <span class="kicker__index">{{ head.index }}</span> — {{ head.kicker }}
    </p>
    <h2 class="section-head__title" id="home-partners-title">{{ head.title }}</h2>
    {% if head.dek %}
      <p class="section-head__dek">{{ head.dek }}</p>
    {% endif %}
  </div>

  <ul class="home-logos">
    {% for partner in page.partners %}
      {%- assign logo_webp = partner.image | remove: '.png' | remove: '.jpg' | append: '-480.webp' -%}
      <li class="home-logo{% if partner.fit %} home-logo--{{ partner.fit }}{% endif %}">
        <a class="home-logo__link" href="{{ partner.url }}">
          <picture>
            {% if site.imagemagick.enabled %}
              <source srcset="{{ logo_webp | relative_url }}" type="image/webp">
            {% endif %}
            <img
              class="home-logo__img"
              src="{{ partner.image | relative_url }}"
              alt="{{ partner.name }}"
              width="{{ partner.width }}"
              height="{{ partner.height }}"
              loading="lazy"
              decoding="async"
            >
          </picture>
        </a>
      </li>
    {% endfor %}
  </ul>
</section>
