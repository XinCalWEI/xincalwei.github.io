{% comment %}
  01 · Research program: framing + background, three numbered thrusts with
  evidence links, the framework diagram, the supporting strand and the vision.
  Copy: page.research.
{% endcomment %}
{%- assign research = page.research -%}
{%- assign head = page.sections.research -%}
<section class="home-section home-research" aria-labelledby="home-research-title">
  <div class="section-head">
    <p class="kicker"><span class="kicker__index">{{ head.index }}</span> — {{ head.kicker }}</p>
    <h2 class="section-head__title" id="home-research-title">{{ head.title }}</h2>
    {% if head.url %}
      <a class="text-link section-head__link" href="{{ head.url | relative_url }}">
        {{- head.link_label }}
        {% include icon.liquid name="arrow-right" -%}
      </a>
    {% endif %}
  </div>

  <div class="home-intro">
    <p class="home-intro__lead">{{ research.framing }}</p>
    <div class="home-intro__bio">
      <p class="home-label">Background</p>
      <p>{{ research.bio }}</p>
    </div>
  </div>

  <ol class="home-thrusts">
    {% for thrust in research.thrusts %}
      <li class="home-thrust">
        <p class="home-thrust__num" aria-hidden="true">{{ thrust.number }}</p>
        <h3 class="home-thrust__title">
          {%- if thrust.url -%}<a class="home-thrust__title-link" href="{{ thrust.url | relative_url }}"><span class="sr-only">Thrust {{ thrust.number }}: </span>{{ thrust.title }}</a>{%- else -%}<span class="sr-only">Thrust {{ thrust.number }}: </span>{{ thrust.title }}{%- endif -%}
        </h3>
        <p class="home-thrust__blurb">{{ thrust.blurb }}</p>
        <ul class="home-thrust__evidence" aria-label="Evidence for thrust {{ thrust.number }}">
          {% for item in thrust.evidence %}
            <li>
              <span class="home-thrust__kind">{{ item.kind }}</span>
              <a class="home-thrust__link" href="{{ item.url | relative_url }}">{{ item.label }}</a>
            </li>
          {% endfor %}
        </ul>
      </li>
    {% endfor %}
  </ol>

  {% include home/framework.liquid %}

  <div class="home-research__coda">
    {% if research.strand %}
      <p class="home-strand">
        <strong class="home-strand__title">{{ research.strand.title }}</strong>
        {{ research.strand.text }}
        <a class="text-link home-strand__link" href="{{ research.strand.url | relative_url }}">
          {{- research.strand.link_label }}
          {% include icon.liquid name="arrow-right" -%}
        </a>
      </p>
    {% endif %}

    {% if research.vision %}
      <div class="home-vision">
        <h3 class="home-vision__lead">{{ research.vision.lead }}</h3>
        <p class="home-vision__text">{{ research.vision.text }}</p>
      </div>
    {% endif %}
  </div>
</section>
