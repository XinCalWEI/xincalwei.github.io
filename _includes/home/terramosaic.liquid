{% comment %}
  TerraMosaic feature band: full-bleed (painted past the container with a
  box-shadow, so it never adds horizontal overflow). Ink band in light mode,
  raised surface in dark. The mosaic-tile motif lives here and nowhere else.
  Copy: page.terramosaic.
{% endcomment %}
{%- assign tm = page.terramosaic -%}
<section class="home-tm" aria-labelledby="home-tm-title">
  <div class="home-tm__grid">
    <div class="home-tm__intro">
      <p class="kicker home-tm__kicker">
        <span class="home-tm__glyph" aria-hidden="true"><span></span><span></span><span></span><span></span></span>
        {{ tm.kicker }}
      </p>
      <h2 class="home-tm__title" id="home-tm-title">{{ tm.title }}</h2>
      <p class="home-tm__tagline">{{ tm.tagline }}</p>
      <p class="home-tm__body">{{ tm.body }}</p>
      <a class="xw-btn home-tm__cta" href="{{ tm.cta.url }}">
        {{- tm.cta.label }}
        {% include icon.liquid name="arrow-up-right" -%}
      </a>
    </div>

    <div class="home-tm__aside">
      {% if tm.logo %}
        <div class="home-tm__plate">
          {%- comment -%}
            WebP widths from jekyll-imagemagick. It never upscales, so the
            first size at or above the original is the original's width.
            sizes mirrors .home-tm__aside minus the plate padding
            (_sass/pages/_home.scss): ~24rem beside the intro from 992px,
            the 30rem card below that, the full column on phones.
          {%- endcomment -%}
          {%- assign tm_logo_base = tm.logo.image | remove: '.png' -%}
          {%- capture tm_logo_srcset -%}
            {%- for w in site.imagemagick.widths -%}
              {%- if w < tm.logo.width -%}
                {{ tm_logo_base | append: '-' | append: w | append: '.webp' | relative_url }} {{ w }}w,
              {%- else -%}
                {{ tm_logo_base | append: '-' | append: w | append: '.webp' | relative_url }} {{ tm.logo.width }}w
                {%- break -%}
              {%- endif -%}
            {%- endfor -%}
          {%- endcapture -%}
          <picture>
            {% if site.imagemagick.enabled %}
              <source
                srcset="{{ tm_logo_srcset | strip | split: ',' | join: ', ' | strip }}"
                sizes="(min-width: 992px) 24rem, (min-width: 512px) 27rem, calc(100vw - 4.5rem)"
                type="image/webp"
              >
            {% endif %}
            <img
              src="{{ tm.logo.image | relative_url }}"
              alt=""
              width="{{ tm.logo.width }}"
              height="{{ tm.logo.height }}"
              loading="lazy"
              decoding="async"
            >
          </picture>
        </div>
      {% endif %}
      <ul class="home-tm__facts">
        {% for fact in tm.facts %}
          <li class="home-tm__fact home-tm__fact--{{ forloop.index }}">{{ fact }}</li>
        {% endfor %}
      </ul>
    </div>
  </div>
</section>
