{% comment %}
  03 · News & writing: latest site.news (page.news.limit) and latest site.posts
  (page.writing.limit) in two columns from 992px, stacked below. Rows: mono
  meta column (date; category for posts) + serif title link (+ one-line dek).
{% endcomment %}
{%- assign news_items = site.news | sort: 'date' | reverse -%}
{%- assign news_limit = page.news.limit | default: 5 -%}
{%- assign post_limit = page.writing.limit | default: 3 -%}
{%- assign head = page.sections.updates -%}
<section class="home-section home-updates" aria-labelledby="home-updates-title">
  <div class="section-head">
    <p class="kicker"><span class="kicker__index">{{ head.index }}</span> — {{ head.kicker }}</p>
    <h2 class="section-head__title" id="home-updates-title">{{ head.title }}</h2>
  </div>

  <div class="home-updates__grid">
    <div class="home-col">
      <div class="home-col__head">
        <h3 class="home-col__title" id="home-news-title">News</h3>
        <a class="text-link" href="{{ '/news/' | relative_url }}">All news {% include icon.liquid name="arrow-right" %}</a>
      </div>
      <ol class="home-dated" aria-labelledby="home-news-title">
        {% for item in news_items limit: news_limit %}
          {%- assign href = item.url | relative_url -%}
          {%- if item.redirect != blank -%}
            {%- if item.redirect contains '://' -%}
              {%- assign href = item.redirect -%}
            {%- else -%}
              {%- assign href = item.redirect | relative_url -%}
            {%- endif -%}
          {%- endif -%}
          <li class="home-dated__item">
            <p class="home-dated__meta">
              <time datetime="{{ item.date | date_to_xmlschema }}">{{ item.date | date: '%-d %b %Y' }}</time>
            </p>
            <p class="home-dated__title">
              {%- if item.inline -%}
                {{ item.content | strip_html | strip }}
              {%- else -%}
                <a href="{{ href }}">{{ item.title }}</a>
              {%- endif -%}
            </p>
          </li>
        {% endfor %}
      </ol>
    </div>

    <div class="home-col">
      <div class="home-col__head">
        <h3 class="home-col__title" id="home-writing-title">Writing</h3>
        <a class="text-link" href="{{ '/blog/' | relative_url }}">All posts {% include icon.liquid name="arrow-right" %}</a>
      </div>
      <ol class="home-dated home-dated--posts" aria-labelledby="home-writing-title">
        {% for post in site.posts limit: post_limit %}
          {%- assign href = post.url | relative_url -%}
          {%- if post.redirect != blank -%}
            {%- if post.redirect contains '://' -%}
              {%- assign href = post.redirect -%}
            {%- else -%}
              {%- assign href = post.redirect | relative_url -%}
            {%- endif -%}
          {%- endif -%}
          {%- assign cat = post.categories | first -%}
          <li class="home-dated__item">
            <p class="home-dated__meta">
              <time datetime="{{ post.date | date_to_xmlschema }}">{{ post.date | date: '%-d %b %Y' }}</time>
              {% if cat %}<span class="home-dated__cat">{{ cat | replace: '-', ' ' }}</span>{% endif %}
            </p>
            <div class="home-dated__body">
              <p class="home-dated__title"><a href="{{ href }}">{{ post.title }}</a></p>
              {% if post.description != blank %}
                <p class="home-dated__dek">{{ post.description | strip_html | strip }}</p>
              {% endif %}
            </div>
          </li>
        {% endfor %}
      </ol>
    </div>
  </div>
</section>
