{% comment %}
  One project on the Research index (_pages/projects.md), styled in _sass/pages/_projects.scss.

  Front matter it reads from _projects/*.md:
    label        mono sub-area label ("Susceptibility"); falls back to sub_area / category
    period       mono years ("2021–2024")
    role         e.g. "Collaborative study" (mono, after the period)
    thumb        a real research figure, shown on a paper plate (object-fit: contain, 3:2)
    thumb_alt    alt text for that figure
    schematic    name of an inline SVG in _includes/research_schematic.liquid (used
                 instead of a figure when a project has none)
    status       e.g. "In development": labelled, and the card is not linked
  `img` / `cover_alt` (the older conceptual covers) are kept in the files but not shown here.
{% endcomment %}
{%- assign project_href = project.url | relative_url -%}
{%- if project.redirect -%}{%- assign project_href = project.redirect -%}{%- endif -%}
{%- assign project_label = project.label | default: project.sub_area | default: project.category -%}
{%- assign project_linked = true -%}
{%- if project.status -%}{%- assign project_linked = false -%}{%- endif -%}
{%- assign project_media = 'none' -%}
{%- if project.schematic -%}
  {%- assign project_media = 'schematic' -%}
{%- elsif project.thumb -%}
  {%- assign project_media = 'figure' -%}
{%- endif -%}

<article class="project-row{% if project_media == 'none' %} project-row--text{% endif %}{% if project_media == 'schematic' %} project-row--feature{% endif %}{% if project.status %} project-row--status{% endif %}">
  {%- if project_media == 'figure' -%}
    <div class="project-plate">
      {%
        include figure.liquid
        path=project.thumb
        sizes="(min-width: 992px) 280px, (min-width: 576px) 40vw, 100vw"
        alt=project.thumb_alt
        class="project-plate__img"
        loading="lazy"
      %}
    </div>
  {%- elsif project_media == 'schematic' -%}
    <div class="project-plate project-plate--schematic">
      {% include research_schematic.liquid name=project.schematic %}
    </div>
  {%- endif -%}

  <div class="project-row__body">
    <p class="project-row__meta">
      <span class="project-row__area">{{ project_label }}</span>
      {%- if project.period -%}<span class="project-row__period">{{ project.period }}</span>{%- endif -%}
      {%- if project.role -%}<span class="project-row__period">{{ project.role }}</span>{%- endif -%}
      {%- if project.status -%}<span class="tag tag--earth project-row__status">{{ project.status }}</span>{%- endif -%}
    </p>
    <h3 class="project-row__title" data-toc-skip>
      {%- if project_linked -%}
        <a class="project-row__link" href="{{ project_href }}">{{ project.title }}</a>
      {%- else -%}
        {{ project.title }}
      {%- endif -%}
    </h3>
    {%- if project.card_description -%}
      <p class="project-row__desc">{{ project.card_description }}</p>
    {%- elsif project.description -%}
      <p class="project-row__desc">{{ project.description }}</p>
    {%- endif -%}
    {%- if project_linked -%}
      <span class="project-row__cta" aria-hidden="true">Read project {% include icon.liquid name="arrow-right" %}</span>
    {%- endif -%}
  </div>
</article>
