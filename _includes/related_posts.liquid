{% comment %}
  "Keep reading" list at the end of a post: the most recent related posts
  (site.related_posts, capped by related_blog_posts.max_related) as hairline
  rows with a mono date column, the same row pattern as the CV and News.
{% endcomment %}
{% capture related_rows %}
  {%- for post in site.related_posts limit: site.related_blog_posts.max_related -%}
    {%- assign related_href = post.url | relative_url -%}
    {%- assign related_external = false -%}
    {%- if post.redirect != blank -%}
      {%- if post.redirect contains '://' -%}
        {%- assign related_href = post.redirect -%}
        {%- assign related_external = true -%}
      {%- else -%}
        {%- assign related_href = post.redirect | relative_url -%}
      {%- endif -%}
    {%- endif %}
    <li class="row-item">
      <p class="row-item__meta"><time datetime="{{ post.date | date_to_xmlschema }}">{{ post.date | date: '%b %Y' }}</time></p>
      <div class="row-item__body">
        <h3 class="row-item__title">
          <a href="{{ related_href }}" {% if related_external %}target="_blank" rel="noopener noreferrer"{% endif %}>
            {{- post.title -}}
            {%- if related_external %}<span class="sr-only"> (opens in a new tab)</span>{% endif -%}
          </a>
        </h3>
        {% if post.description %}
          <p class="row-item__dek">{{ post.description | strip_html | strip }}</p>
        {% endif %}
      </div>
    </li>
  {%- endfor -%}
{% endcapture %}

{% if related_rows contains '<li' %}
  <aside class="related-posts" aria-labelledby="related-posts-title">
    <div class="section-head">
      <p class="kicker">Keep reading</p>
      <h2 class="section-head__title" id="related-posts-title" data-toc-skip>More from the blog</h2>
    </div>
    <ul class="list-rows">
      {{ related_rows }}
    </ul>
  </aside>
{% endif %}

{% if site.newsletter.enabled and site.footer_fixed %}
  <p class="related-posts__newsletter">Subscribe to be notified of future articles:</p>
  {% include newsletter.liquid left=true %}
{% endif %}
