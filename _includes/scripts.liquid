<!-- jQuery -->
{% comment %}
  Self-hosted (assets/js/jquery.min.js, the unmodified 3.6.0 file, so the SRI hash
  in _config.yml still applies): no second origin on the critical path. A full URL
  in _config.yml switches back to a CDN.
{% endcomment %}
{% assign jquery_src = site.third_party_libraries.jquery.url.js %}
{% unless jquery_src contains '://' %}
  {% assign jquery_src = jquery_src | relative_url %}
{% endunless %}
<script
  src="{{ jquery_src }}"
  integrity="{{ site.third_party_libraries.jquery.integrity.js }}"
  crossorigin="anonymous"
></script>

<!-- Bootstrap scripts (collapse, dropdown, scrollspy) -->
<script src="{{ '/assets/js/bootstrap.bundle.min.js' | relative_url }}"></script>

{% if site.enable_masonry %}
  <!-- Masonry & imagesLoaded -->
