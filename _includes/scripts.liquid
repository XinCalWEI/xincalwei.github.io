{% if site.back_to_top %}
  <!-- Back to Top -->
  <script src="{{ '/assets/js/vanilla-back-to-top.min.js' | relative_url | bust_file_cache }}"></script>
  <script>
    addBackToTop();
    // The library builds a bare <div>: make it a named button that keyboard and
    // screen-reader users can reach while it is shown (it is faded out, and here
    // also unfocusable, at the top of the page). Activating it from the keyboard
    // puts focus back at the top of the tab order (the skip link).
    (function () {
      var btt = document.getElementById('back-to-top');
      if (!btt) return;
      btt.setAttribute('role', 'button');
      btt.setAttribute('aria-label', 'Back to top');
      var sync = function () {
        var hidden = btt.classList.contains('hidden');
        btt.tabIndex = hidden ? -1 : 0;
        btt.setAttribute('aria-hidden', hidden ? 'true' : 'false');
      };
      sync();
      new MutationObserver(sync).observe(btt, { attributes: true, attributeFilter: ['class'] });
      btt.addEventListener('keydown', function (e) {
        if (e.key !== 'Enter' && e.key !== ' ') return;
        e.preventDefault();
        btt.click();
        var skip = document.querySelector('.skip-link');
        if (skip) skip.focus({ preventScroll: true });
      });
    })();
  </script>
{% endif %}

{% if site.search_enabled %}
  <!-- Search -->
  <script type="module" src="{{ '/assets/js/search/ninja-keys.min.js' | relative_url | bust_file_cache }}"></script>
  {% comment %}
    The slotted footer replaces the library's key hints (styled in ds/_chrome,
    hidden on phones and touch screens) and holds the live region search-setup.js
    fills with the result count and the selected result.
  {% endcomment %}
  <ninja-keys hideBreadcrumbs noAutoLoadMdIcons placeholder="Type to start searching">
    <div slot="footer" class="ninja-footer">
      <p class="ninja-footer__hints" aria-hidden="true">
        <span><kbd>Enter</kbd>to open</span>
        <span><kbd>&uarr;</kbd><kbd>&darr;</kbd>to move</span>
        <span><kbd>Esc</kbd>to close</span>
      </p>
      <p id="search-status" class="sr-only" role="status"></p>
    </div>
  </ninja-keys>
  <script src="{{ '/assets/js/search-setup.js' | relative_url | bust_file_cache }}"></script>
  <script src="{{ '/assets/js/search-data.js' | relative_url }}"></script>
  <script src="{{ '/assets/js/shortcut-key.js' | relative_url | bust_file_cache }}"></script>
{% endif %}

{% if site.newsletter.enabled %}
  <script defer src="{{ '/assets/js/newsletter.js' | relative_url | bust_file_cache }}"></script>
{% endif %}
