---
layout: default
layout_width: wide
---
{% comment %}
  Year / tag / category archives (jekyll-archives-v2) for the blog and the
  bookshelf. Same page header as every inner page; blog archives reuse the
  blog index cards (_includes/blog_card.liquid), book archives the shelf grid.
{% endcomment %}
{% assign first_document = page.documents | first %}
{% assign is_book_archive = false %}
{% if first_document.layout == 'book-review' %}
  {% assign is_book_archive = true %}
{% endif %}
{% assign archive_display_title = page.title %}
{% unless is_book_archive %}
  {% if page.type == 'categories' %}
    {% for taxonomy_category in site.data.blog_taxonomy.categories %}
      {% if taxonomy_category.key == page.title %}
        {% assign archive_display_title = taxonomy_category.label %}
      {% endif %}
    {% endfor %}
  {% elsif page.type == 'tags' %}
    {% for taxonomy_tag in site.data.blog_taxonomy.tags %}
      {% if taxonomy_tag.key == page.title %}
        {% assign archive_display_title = taxonomy_tag.label %}
      {% endif %}
    {% endfor %}
  {% endif %}
{% else %}
  {% assign archive_display_title = page.title | replace: '-', ' ' | capitalize %}
{% endunless %}
{% if is_book_archive %}
  {% assign index_url = '/books/' %}
  {% assign index_name = 'Bookshelf' %}
  {% assign index_label = 'All books' %}
  {% assign item_word = 'book' %}
{% else %}
  {% assign index_url = '/blog/' %}
  {% assign index_name = 'Blog' %}
  {% assign index_label = 'All posts' %}
  {% assign item_word = 'post' %}
{% endif %}
{% assign n = page.documents | size %}

<div class="post tm-blog tm-archive">
  <header class="post-header">
    <p class="kicker">
      <a href="{{ index_url | relative_url }}">{{ index_name }}</a>
      <span aria-hidden="true">·</span>
      <span>{% if page.type == 'categories' %}{% if is_book_archive %}Subject{% else %}Category{% endif %}{% elsif page.type == 'tags' %}Tag{% else %}Year{% endif %}</span>
    </p>
    <h1 class="post-title">
      {% if page.type == 'year' %}{{ page.date | date: '%Y' }}{% else %}{{ archive_display_title }}{% endif %}
    </h1>
    <p class="post-description">
      {{- n }} {{ item_word }}{% if n != 1 %}s{% endif %}
      {% if page.type == 'categories' %}in this {% if is_book_archive %}subject{% else %}category{% endif %}{% elsif page.type == 'tags' %}with this tag{% else %}from this year{% endif %}
    </p>
  </header>

  {% if is_book_archive %}
    <div class="tm-shelf">
      <ul class="shelf__grid">
        {% for book in page.documents %}
          {% include books/shelf_item.liquid book=book %}
        {% endfor %}
      </ul>
    </div>
  {% else %}
    {% assign archive_remainder = n | modulo: 2 %}
    <div class="blog-grid">
      {% for post in page.documents %}
        {% if n == 1 %}
          {% include blog_card.liquid post=post solo=true priority=forloop.first %}
        {% else %}
          {% assign is_archive_tail = false %}
          {% if forloop.last and archive_remainder == 1 %}
            {% assign is_archive_tail = true %}
          {% endif %}
          {% include blog_card.liquid post=post tail=is_archive_tail priority=forloop.first %}
        {% endif %}
      {% endfor %}
    </div>
  {% endif %}

  <p class="archive-back">
    <a class="text-link" href="{{ index_url | relative_url }}">
      {%- include icon.liquid name="arrow-right" class="icon--flip" %}
      {{ index_label -}}
    </a>
  </p>
</div>
