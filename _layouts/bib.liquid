---
---
{% comment %}
  One bibliography entry, rendered by jekyll-scholar on /publications/, the homepage
  selected list (_includes/selected_papers.liquid) and the project pages' References.
  Styles: _sass/ds/_publications.scss.

  DOM contract (assets/js/common.js, abstract-modal.js, bibsearch.js depend on it):
    li > div.row > div.abbr + div#<key>
    div#<key> > .title, .author, .periodical, .links > button.abstract|bibtex|award,
    and the .abstract/.bibtex/.award.hidden panels as direct children of div#<key>
    (the toggle buttons sit exactly two levels below them).

  Liquid variables persist from one entry to the next, so every per-entry value
  below is (re)assigned unconditionally; a stray "Dec" from the AGU entries used
  to leak onto the journal articles after them.
{% endcomment %}
{%- assign bib_all_authors_up_to = 8 -%}
{%- assign bib_shown_when_truncated = 6 -%}

{%- comment -%} Authorship flags used by the filters and the author list {%- endcomment -%}
{%- assign mentee_names = site.data.mentees | map: 'name' -%}
{%- for mentee in site.data.mentees -%}
  {%- if mentee.aliases -%}{%- assign mentee_names = mentee_names | concat: mentee.aliases -%}{%- endif -%}
{%- endfor -%}
{%- assign self_position = 0 -%}
{%- for author in entry.author_array -%}
  {%- assign author_last_name = author.last | regex_replace: '[*∗†‡§¶‖&^]', '' -%}
  {%- if site.scholar.last_name contains author_last_name and site.scholar.first_name contains author.first -%}
    {%- assign self_position = forloop.index -%}
    {%- break -%}
  {%- endif -%}
{%- endfor -%}
{%- if entry.type == 'article' -%}
  {%- assign pub_type = 'journal' -%}
{%- else -%}
  {%- assign pub_type = 'conference' -%}
{%- endif -%}

{%- comment -%} Primary destination: DOI first, then the publisher / meeting page {%- endcomment -%}
{%- assign entry_url = '' -%}
{%- if entry.doi -%}
  {%- assign entry_url = 'https://doi.org/' | append: entry.doi -%}
{%- elsif entry.html -%}
  {%- if entry.html contains '://' -%}
    {%- assign entry_url = entry.html -%}
  {%- else -%}
    {%- assign entry_url = entry.html | prepend: '/assets/html/' | relative_url -%}
  {%- endif -%}
{%- endif -%}

<div class="row" data-pub-type="{{ pub_type }}" data-first-author="{% if self_position == 1 %}true{% else %}false{% endif %}">
  {% if site.enable_publication_thumbnails %}
    <div class="col col-sm-2 abbr">
      {%- if entry.year -%}
        <span class="bib-year">{{ entry.year }}</span>
      {%- endif -%}
      {%- if entry.abbr -%}
        {%- if site.data.venues[entry.abbr] -%}
          {% assign venue_style = null %}
          {% if site.data.venues[entry.abbr].color != blank %}
            {% assign venue_style = site.data.venues[entry.abbr].color | prepend: 'style="background-color:' | append: '"' %}
          {%- endif -%}
          <abbr
            class="badge"
            {% if venue_style %}
              {{ venue_style }}
            {% endif -%}
          >
            {% if site.data.venues[entry.abbr].url %}
              <a href="{{ site.data.venues[entry.abbr].url }}">{{ entry.abbr }}</a>
            {% else %}
              <div>{{- entry.abbr -}}</div>
            {% endif %}
          </abbr>
        {% else %}
          <abbr class="badge" title="{{ entry.journal | default: entry.booktitle | default: entry.howpublished | strip_html | escape }}">
            {{- entry.abbr -}}
          </abbr>
        {% endif %}
      {% endif %}
      {% if entry.preview %}
        {% if entry.preview contains '://' %}
          <img class="preview z-depth-1 rounded" src="{{ entry.preview }}">
        {% else %}
          {% assign entry_path = entry.preview | prepend: '/assets/img/publication_preview/' %}
          {%
            include figure.liquid
            loading="eager"
            path=entry_path
            sizes = "200px"
            class="preview z-depth-1 rounded"
            zoomable=true
            avoid_scaling=true
            alt=entry.preview
          %}
        {% endif %}
      {% endif %}
    </div>
  {% endif %}

  <!-- Entry bib key -->
  <div id="{{ entry.key }}" class="{% if site.enable_publication_thumbnails %}col-sm-8{% else %}col-sm-10{% endif %}">
    <!-- Title -->
    <div class="title" id="{{ entry.key }}-title">
      {%- if entry_url != '' -%}
        <a href="{{ entry_url }}">{{ entry.title }}</a>
      {%- else -%}
        {{ entry.title }}
      {%- endif -%}
    </div>
    <!-- Author -->
    <div class="author">
      {%- assign author_array_size = entry.author_array | size -%}
      {%- assign author_array_limit = author_array_size -%}
      {%- if author_array_size > bib_all_authors_up_to -%}
        {%- unless entry.show_all_authors -%}
          {%- comment -%} long lists are cut, but never before Xin Wei's own position {%- endcomment -%}
          {%- assign author_array_limit = bib_shown_when_truncated -%}
          {%- if self_position > author_array_limit -%}
            {%- assign author_array_limit = self_position -%}
          {%- endif -%}
        {%- endunless -%}
      {%- endif -%}

      {%- for author in entry.author_array limit: author_array_limit -%}
        {%- assign author_is_self = false -%}
        {%- if forloop.index == self_position -%}{%- assign author_is_self = true -%}{%- endif -%}
        {%- assign author_last_name = author.last | regex_replace: '[*∗†‡§¶‖&^]', '' -%}
        {%- assign author_last_html = author.last | regex_replace: '([*∗†‡§¶‖&^]+)', '<sup>\1</sup>' -%}
        {%- assign author_full_name = author.first | append: ' ' | append: author_last_name -%}
        {%- assign coauthor_url = null -%}
        {%- assign clean_last_name = author_last_name | downcase | remove_accents -%}
        {%- if site.data.coauthors[clean_last_name] -%}
          {%- for coauthor in site.data.coauthors[clean_last_name] -%}
            {%- if coauthor.firstname contains author.first -%}
              {%- assign coauthor_url = coauthor.url -%}
              {%- break -%}
            {%- endif -%}
          {%- endfor -%}
        {%- endif -%}

        {%- if forloop.length > 1 -%}
          {%- if forloop.first == false -%}
            {%- if forloop.length > 2 or author_array_limit < author_array_size -%}{{ ', ' }}{%- else -%}{{ ' ' }}{%- endif -%}
          {%- endif -%}
          {%- if forloop.last and author_array_limit == author_array_size %}and {% endif -%}
        {%- endif -%}
        {%- comment -%} one output per name, so a name stays one text node ("Xin Wei") for the search highlighter {%- endcomment -%}
        {%- assign author_display = author.first | append: ' ' | append: author_last_html -%}
        {%- if author_is_self -%}
          <em>{{ author_display }}</em>
        {%- elsif coauthor_url -%}
          <a href="{{ coauthor_url }}">{{ author_display }}</a>
        {%- else -%}
          {{ author_display }}
        {%- endif -%}
        {%- if mentee_names contains author_full_name -%}
          <sup class="bib-mentee" title="Student mentee" aria-hidden="true">†</sup><span class="sr-only"> (student mentee)</span>
        {%- endif -%}
      {%- endfor -%}

      {%- assign more_authors = author_array_size | minus: author_array_limit -%}
      {%- if more_authors > 0 -%}
        {%- capture more_authors_label -%}and {{ more_authors }} more author{% if more_authors > 1 %}s{% endif %}{%- endcapture -%}
        {%- capture more_authors_show -%}
          {%- for author in entry.author_array offset: author_array_limit -%}
            {%- if forloop.last and forloop.length > 1 %}and {% endif -%}
            {{ author.first }} {{ author.last | regex_replace: '([*∗†‡§¶‖&^]+)', '<sup>\1</sup>' }}
            {%- unless forloop.last %}, {% endunless -%}
          {%- endfor -%}
        {%- endcapture -%}
        {%- comment -%}
          Real button (keyboard + screen reader); the rest of the list is in the DOM
          (so search can find it) and is revealed instantly, no typewriter effect.
        {%- endcomment -%}
        , <span class="more-authors-list" id="{{ entry.key }}-more-authors" hidden>{{ more_authors_show }}</span>
        <button
          type="button"
          class="more-authors"
          aria-expanded="false"
          aria-controls="{{ entry.key }}-more-authors"
          data-label="{{ more_authors_label }}"
          onclick="var l=document.getElementById(this.getAttribute('aria-controls')),o=this.getAttribute('aria-expanded')==='true';l.hidden=o;this.setAttribute('aria-expanded',o?'false':'true');this.textContent=o?this.getAttribute('data-label'):'show fewer';"
        >
          {{- more_authors_label -}}
        </button>
      {%- endif -%}
    </div>

    <!-- Venue, volume(issue), pages, date. Talks (@misc) give their event in howpublished. -->
    {%- assign proceedings = 'inproceedings,incollection' | split: ',' -%}
    {%- assign thesis = 'thesis,mastersthesis,phdthesis' | split: ',' -%}
    {%- assign entry_pages = entry.pages | default: '' | replace: '--', '–' | replace: '-', '–' -%}
    {%- capture periodical_venue -%}
      {%- if entry.type == 'article' -%}
        <em>{{ entry.journal }}</em>
        {%- if entry.volume %} {{ entry.volume }}{% if entry.number %}({{ entry.number }}){% endif %}{% endif -%}
        {%- if entry_pages != '' %}, {{ entry_pages }}{% endif -%}
      {%- elsif proceedings contains entry.type -%}
        <em>{{ entry.booktitle }}</em>
        {%- if entry.address %}, {{ entry.address }}{% endif -%}
        {%- if entry_pages != '' %}, pp. {{ entry_pages }}{% endif -%}
      {%- elsif thesis contains entry.type -%}
        <em>{{ entry.school }}</em>
      {%- elsif entry.type == 'misc' and entry.howpublished -%}
        <em>{{ entry.howpublished }}</em>
        {%- if entry.address %}, {{ entry.address }}{% endif -%}
      {%- endif -%}
      {%- if entry.location %}, {{ entry.location }}{% endif -%}
    {%- endcapture -%}
    {%- assign periodical_venue = periodical_venue | strip -%}
    {%- capture periodical -%}
      {{- periodical_venue -}}
      {%- if entry.year -%}
        {%- if periodical_venue != '' %}, {% endif -%}
        {%- if entry.month and entry.type != 'article' -%}
          {{ entry.month | capitalize }}
          {%- if entry.day %} {{ entry.day }},{% endif %} {% endif -%}
        {{ entry.year }}
      {%- endif -%}
    {%- endcapture -%}
    {% comment %}
      additional_info is shown as its own "honors" line (e.g. ESI Highly Cited Paper)
      rather than appended to the venue; a leading ". " separator is dropped.
    {% endcomment %}
    {%- assign honors = '' -%}
    {%- if entry.additional_info -%}
      {%- assign honors = entry.additional_info | markdownify | remove: '<p>' | remove: '</p>' | strip -%}
      {%- assign honors_lead = honors | slice: 0, 2 -%}
      {%- if honors_lead == '. ' or honors_lead == ', ' -%}
        {%- assign honors = honors | slice: 2, honors.size -%}
      {%- endif -%}
    {%- endif -%}
    {% capture hook_exists %}{% file_exists _includes/hook/bib.liquid %}{% endcapture %}
    {% if hook_exists == 'true' %}
      {% include hook/bib.liquid %}
    {% endif %}
    <div class="periodical">{{ periodical | strip }}</div>
    {% if entry.note and entry.note != '' %}
      <div class="periodical note">{{ entry.note | strip }}</div>
    {% endif %}
    {% comment %} annotation: site-only commentary (e.g. an honor, or the session it was given in); filtered out of the BibTeX {% endcomment %}
    {% if entry.annotation and entry.annotation != '' %}
      <div class="periodical note">{{ entry.annotation | strip }}</div>
    {% endif %}
    {% if honors != '' %}
      <div class="honors">{{ honors }}</div>
    {% endif %}

    <!-- Actions, fixed order: Abstract · DOI/Link · arXiv · PDF · … · BibTeX -->
    <div class="links">
      {% if entry.award %}
        <button type="button" class="award btn btn-sm" aria-expanded="false" aria-describedby="{{ entry.key }}-title">
          {%- if entry.award_name %}{{ entry.award_name }}{% else %}Awarded{% endif -%}
        </button>
      {% endif %}
      {% if entry.abstract %}
        <button type="button" class="abstract btn btn-sm" aria-expanded="false" aria-describedby="{{ entry.key }}-title">Abstract</button>
      {% endif %}
      {% if entry.doi %}
        <a href="https://doi.org/{{ entry.doi }}" class="btn btn-sm" aria-label="DOI {{ entry.doi }}" aria-describedby="{{ entry.key }}-title">DOI</a>
      {% elsif entry.html %}
        {%- if entry.html contains 'confex' -%}
          {%- assign html_label = 'AGU abstract' -%}
        {%- elsif entry.type == 'misc' -%}
          {%- assign html_label = 'Event page' -%}
        {%- else -%}
          {%- assign html_label = 'Publisher page' -%}
        {%- endif -%}
        <a href="{{ entry_url }}" class="btn btn-sm" aria-describedby="{{ entry.key }}-title">{{ html_label }}</a>
      {% endif %}
      {% if entry.arxiv %}
        <a href="https://arxiv.org/abs/{{ entry.arxiv }}" class="btn btn-sm" aria-describedby="{{ entry.key }}-title">arXiv</a>
      {% endif %}
      {% if entry.pdf %}
        {% if entry.pdf contains '://' %}
          <a href="{{ entry.pdf }}" class="btn btn-sm" aria-describedby="{{ entry.key }}-title">PDF</a>
        {% else %}
          <a href="{{ entry.pdf | prepend: '/assets/pdf/' | relative_url }}" class="btn btn-sm" aria-describedby="{{ entry.key }}-title">PDF</a>
        {% endif %}
      {% endif %}
      {% if entry.supp %}
        {% if entry.supp contains '://' %}
          <a href="{{ entry.supp }}" class="btn btn-sm" aria-describedby="{{ entry.key }}-title">Supp</a>
        {% else %}
          <a href="{{ entry.supp | prepend: '/assets/pdf/' | relative_url }}" class="btn btn-sm" aria-describedby="{{ entry.key }}-title">Supp</a>
        {% endif %}
      {% endif %}
      {% if entry.code %}
        <a href="{{ entry.code }}" class="btn btn-sm" aria-describedby="{{ entry.key }}-title">Code</a>
      {% endif %}
      {% if entry.video and site.enable_video_embedding %}
        <button type="button" class="abstract btn btn-sm" aria-expanded="false" aria-describedby="{{ entry.key }}-title">Video</button>
      {% elsif entry.video %}
        <a href="{{ entry.video }}" class="btn btn-sm" aria-describedby="{{ entry.key }}-title">Video</a>
      {% endif %}
      {% if entry.poster %}
        {% if entry.poster contains '://' %}
          <a href="{{ entry.poster }}" class="btn btn-sm" aria-describedby="{{ entry.key }}-title">Poster</a>
        {% else %}
          <a href="{{ entry.poster | prepend: '/assets/pdf/' | relative_url }}" class="btn btn-sm" aria-describedby="{{ entry.key }}-title">Poster</a>
        {% endif %}
      {% endif %}
      {% if entry.slides %}
        {% if entry.slides contains '://' %}
          <a href="{{ entry.slides }}" class="btn btn-sm" aria-describedby="{{ entry.key }}-title">Slides</a>
        {% else %}
          <a href="{{ entry.slides | prepend: '/assets/pdf/' | relative_url }}" class="btn btn-sm" aria-describedby="{{ entry.key }}-title">Slides</a>
        {% endif %}
      {% endif %}
      {% if entry.website %}
        <a href="{{ entry.website }}" class="btn btn-sm" aria-describedby="{{ entry.key }}-title">Website</a>
      {% endif %}
      {% if entry.blog %}
        <a href="{{ entry.blog }}" class="btn btn-sm" aria-describedby="{{ entry.key }}-title">Blog</a>
      {% endif %}
      {% if entry.bibtex_show %}
        <button type="button" class="bibtex btn btn-sm" aria-expanded="false" aria-describedby="{{ entry.key }}-title">BibTeX</button>
      {% endif %}
    </div>
    {% if site.enable_publication_badges %}
      {% assign entry_has_altmetric_badge = false %}
      {% if entry.altmetric and entry.altmetric != 'false' %}
        {% assign entry_has_altmetric_badge = true %}
      {% endif %}

      {% assign entry_has_dimensions_badge = false %}
      {% if entry.dimensions and entry.dimensions != 'false' %}
        {% assign entry_has_dimensions_badge = true %}
      {% endif %}

      {% assign entry_has_google_scholar_badge = false %}
      {% if entry.google_scholar_id %}
        {% assign entry_has_google_scholar_badge = true %}
      {% endif %}

      {% assign entry_has_inspirehep_badge = false %}
      {% if entry.inspirehep_id %}
        {% assign entry_has_inspirehep_badge = true %}
      {% endif %}
      {% if entry_has_altmetric_badge or entry_has_dimensions_badge or entry_has_google_scholar_badge or entry_has_inspirehep_badge %}
        <div class="badges">
          {% if site.enable_publication_badges.altmetric and entry_has_altmetric_badge %}
            <span
              class="altmetric-embed"
              data-badge-type="2"
              data-badge-popover="right"
              {% if entry.altmetric != blank and entry.altmetric != 'true' %}
                data-altmetric-id="{{ entry.altmetric }}"
              {% elsif entry.arxiv %}
                data-arxiv-id="{{ entry.arxiv }}"
              {% elsif entry.eprint %}
                data-arxiv-id="{{ entry.eprint }}"
              {% elsif entry.doi %}
                data-doi="{{ entry.doi }}"
              {% elsif entry.pmid %}
                data-pmid="{{ entry.pmid }}"
              {% elsif entry.isbn %}
                data-isbn="{{ entry.isbn }}"
              {% endif %}
            ></span>
          {% endif %}
          {% if site.enable_publication_badges.dimensions and entry_has_dimensions_badge %}
            <span
              class="__dimensions_badge_embed__"
              {% if entry.dimensions != blank and entry.dimensions != 'true' %}
                data-id="{{ entry.dimensions }}"
              {% elsif entry.doi %}
                data-doi="{{ entry.doi }}"
              {% else %}
                data-pmid="{{ entry.pmid }}"
              {% endif %}
              data-style="small_rectangle"
              data-legend="hover-right"
              style="margin-bottom: 3px;"
            ></span>
          {% endif %}
          {% comment %}
            Inline citation count, replacing the remote img.shields.io badge: no third-party
            request, no referrer leak, and it inherits the theme in both light and dark.
            Rendered only when there is a count to show, so 0-citation entries stay quiet.
            NOTE: the markup deliberately contains no <span> — _sass/_base.scss:827 has
            `.publications ol.bibliography li .badges span { color: #000 }` at (0,3,3),
            which would paint the number pure black on the dark background.
          {% endcomment %}
          {% if site.enable_publication_badges.google_scholar and entry_has_google_scholar_badge %}
            {% assign cite_count = entry.citations | plus: 0 %}
            {% if cite_count > 0 %}
              <a
                class="cite-count"
                href="https://scholar.google.com/citations?view_op=view_citation&hl=en&user={{ site.data.socials.scholar_userid }}&citation_for_view={{ site.data.socials.scholar_userid }}:{{ entry.google_scholar_id }}"
                aria-label="{{ cite_count }} citations on Google Scholar"
                title="Citations on Google Scholar"
              >
                <b>{{ cite_count }}</b> citations
              </a>
            {% endif %}
          {% endif %}
          {% if site.enable_publication_badges.inspirehep and entry_has_inspirehep_badge %}
            <a
              href="https://inspirehep.net/literature/{{ entry.inspirehep_id }}"
              aria-label="Inspirehep link"
              role="button"
            >
              <img
                src="https://img.shields.io/badge/inspire-{% inspirehep_citations entry.inspirehep_id %}-001628?logo=inspire&logoColor=001628&labelColor=beige"
                alt="{% inspirehep_citations entry.inspirehep_id %} InspireHEP citations"
              >
            </a>
          {% endif %}
        </div>
      {% endif %}
    {% endif %}

    {% if entry.award %}
      <!-- Hidden Award block -->
      <div class="award hidden d-print-inline">
        <p>{{ entry.award | markdownify }}</p>
      </div>
    {% endif %}

    {% if entry.abstract %}
      <!-- Hidden abstract block -->
      <div class="abstract hidden">
        <p>{{ entry.abstract }}</p>
      </div>
    {% endif %}

    {% if entry.bibtex_show %}
      {% comment %} Hidden BibTeX. Site-only fields are stripped; \x7b/\x7d stand for braces because Liquid ends an output tag at a bare closing brace. {% endcomment %}
      <div class="bibtex hidden">
        {% highlight bibtex %}
        {{- entry.bibtex | hideCustomBibtex -}}
      {% endhighlight %}
      </div>
    {% endif %}

    {% if entry.video and site.enable_video_embedding %}
      <!-- Hidden video block -->
      <div class="abstract hidden">
        <div style="text-align: center;">{% include video.liquid path=entry.video class="img-fluid rounded z-depth-1" controls=true %}</div>
      </div>
    {% endif %}
  </div>
</div>
