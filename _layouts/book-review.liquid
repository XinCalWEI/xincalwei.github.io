---
layout: default
---
{% comment %}
  A single book (_books/*.md). Header pattern shared with articles: kicker
  (Bookshelf · shelf), title, mono meta (author · year), subject tags linking to
  the book archives. Body: cover beside the note (a two-column grid from 768px,
  so the cover can no longer float past the footer). Text links only.
{% endcomment %}
{% assign year = page.started | date: '%Y' %}
{% assign shelf_label = page.status %}
{% if page.status == 'Read' %}{% assign shelf_label = 'Books I love' %}{% endif %}
{% if page.status == 'Recommended Textbooks' %}{% assign shelf_label = 'Recommended textbooks' %}{% endif %}

{% if page._styles %}
  <!-- Page/Post style -->
  <style type="text/css">
    {{ page._styles }}
  </style>
{% endif %}

<div class="post book-page">
  <header class="post-header">
    <p class="kicker">
      <a href="{{ '/books/' | relative_url }}">Bookshelf</a>
      {%- if shelf_label %}<span aria-hidden="true">·</span><span>{{ shelf_label }}</span>{% endif %}
    </p>
    <h1 class="post-title">{{ page.title }}</h1>
    {% if page.author or page.released %}
      <p class="post-meta">
        {{- page.author -}}
        {%- if page.author and page.released %}<span aria-hidden="true"> · </span>{% endif -%}
        {{- page.released -}}
      </p>
    {% endif %}
    {% if page.started or page.finished or page.stars %}
      <p class="post-meta">
        {%- if page.started %}Started {{ page.started }}{% endif -%}
        {%- if page.started and page.finished %}<span aria-hidden="true"> · </span>{% endif -%}
        {%- if page.finished %}Finished {{ page.finished }}{% endif -%}
        {%- if page.stars -%}
          {%- if page.started or page.finished %}<span aria-hidden="true"> · </span>{% endif -%}
          Rating {{ page.stars }}/5
        {%- endif -%}
      </p>
    {% endif %}
    {% if page.categories.size > 0 or page.tags.size > 0 or page.started %}
      <ul class="article-tags" aria-label="Book archives">
        {% if page.started %}
          <li>
            <a class="tag" href="{{ year | prepend: '/books/' | append: '/' | relative_url }}"><span class="sr-only">Books from </span>{{ year }}</a>
          </li>
        {% endif %}
        {% for tag in page.tags %}
          <li>
            <a class="tag" href="{{ tag | slugify | prepend: '/books/tag/' | append: '/' | relative_url }}"><span class="sr-only">Tag: </span>{{ tag | replace: '-', ' ' }}</a>
          </li>
        {% endfor %}
        {% for category in page.categories %}
          <li>
            <a class="tag" href="{{ category | slugify | prepend: '/books/category/' | append: '/' | relative_url }}"><span class="sr-only">Subject: </span>{{ category | replace: '-', ' ' }}</a>
          </li>
        {% endfor %}
      </ul>
    {% endif %}
  </header>

  <article class="book-page__body">
    {% capture cover_src %}{% if page.cover %}{{ page.cover | relative_url }}{% elsif page.olid %}https://covers.openlibrary.org/b/olid/{{ page.olid }}-L.jpg?default=false{% elsif page.isbn %}https://covers.openlibrary.org/b/isbn/{{ page.isbn }}-L.jpg?default=false{% endif %}{% endcapture %}
    {% if cover_src != '' %}
      <figure class="book-page__cover">
        <img src="{{ cover_src }}" alt="Cover of {{ page.title }}"{% if page.cover_width %} width="{{ page.cover_width }}" height="{{ page.cover_height }}"{% endif %}>
        {% if page.olid %}
          <figcaption class="caption">Cover via <a href="https://openlibrary.org/olid/{{ page.olid }}">Open Library</a></figcaption>
        {% elsif page.isbn %}
          <figcaption class="caption">Cover via <a href="https://openlibrary.org/isbn/{{ page.isbn }}">Open Library</a></figcaption>
        {% endif %}
      </figure>
    {% endif %}

    <div class="prose">
      {% if content == '' %}
        <p class="book-page__status"><span class="tag">{{ page.status }}</span></p>
      {% else %}
        {% if page.start or page.end %}
          <p class="post-meta">
            {%- if page.start %}Started {{ page.start | date: '%-d %B %Y' }}{% endif -%}
            {%- if page.start and page.end %} · {% endif -%}
            {%- if page.end %}Finished {{ page.end | date: '%-d %B %Y' }}{% endif -%}
          </p>
        {% endif %}
        {{ content }}
      {% endif %}

      {% if page.buy_link or page.goodreads_review %}
        <p class="book-page__links">
          {% if page.buy_link %}
            {% assign is_amazon_link = page.buy_link | slice: 0, 19 %}
            <a class="text-link" href="{{ page.buy_link }}" target="_blank" rel="noopener noreferrer">
              {%- if is_amazon_link == 'https://www.amazon.' %}View on Amazon{% else %}Publisher's page{% endif %}
              {% include icon.liquid name="arrow-up-right" %}
              <span class="sr-only">(opens in a new tab)</span>
            </a>
          {% endif %}
          {% if page.goodreads_review %}
            <a class="text-link" href="https://www.goodreads.com/review/show/{{ page.goodreads_review }}" target="_blank" rel="noopener noreferrer">
              Review on Goodreads {% include icon.liquid name="arrow-up-right" %}
              <span class="sr-only">(opens in a new tab)</span>
            </a>
          {% endif %}
        </p>
      {% endif %}

      <p class="book-page__back">
        <a class="text-link" href="{{ '/books/' | relative_url }}">
          {%- include icon.liquid name="arrow-right" class="icon--flip" %} All books</a
        >
      </p>
    </div>
  </article>

  {% if site.giscus and page.giscus_comments %}
    {% include giscus.liquid %}
  {% endif %}
</div>
