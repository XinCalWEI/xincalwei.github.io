---
layout: page
layout_width: wide
---
{% comment %}
  Bookshelf (/books/): the page's own content (an epigraph) followed by one
  shelf per status, in the order below. Covers stand on a common baseline at
  their own shape. Styles: .tm-shelf in _sass/pages/_inner.scss.
{% endcomment %}
<div class="shelf-intro">
  {{ content }}
</div>

{% if page.collection and page.collection.size > 0 %}
  {% assign collection = site[page.collection] %}
  {% if collection and collection.size > 0 %}
    {% assign section_order = 'Citations,Read,Recommended Textbooks' | split: ',' %}
    {% assign section_titles = 'Citations,Books I Love,Recommended Textbooks and Academic Monographs' | split: ',' %}
    <div class="tm-shelf">
      {% for section_index in (0..2) %}
        {% assign section_status = section_order[section_index] %}
        {% assign section_title = section_titles[section_index] %}
        {% assign section_books = collection | where: 'status', section_status %}
        {% if section_books.size > 0 %}
          <section class="shelf" aria-labelledby="{{ section_status | slugify }}">
            <div class="shelf__head">
              <h2 class="shelf__title" id="{{ section_status | slugify }}">{{ section_title }}</h2>
              <span class="shelf__count">{{ section_books.size }} book{% if section_books.size != 1 %}s{% endif %}</span>
            </div>
            <ul class="shelf__grid">
              {% for item in section_books reversed %}
                {% include books/shelf_item.liquid book=item %}
              {% endfor %}
            </ul>
          </section>
        {% endif %}
      {% endfor %}
    </div>
  {% endif %}
{% endif %}
