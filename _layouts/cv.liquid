---
layout: default
---
{% comment %}
  /cv/ — one source of truth: _data/cv.yml (section order, facts). Sections with
  `placement: header` render in the page header; `publications`, `teaching` and
  `mentoring` sections are generated from papers.bib, _data/teaching.yml and the
  People page, so the CV never drifts from those pages.

  Layout: two-column timeline rows (mono years left, entry right) from 768px up,
  stacked below. "Print / Save as PDF" calls window.print(); the print rules in
  _sass/_cv.scss turn the page into a clean paper CV (no chrome, black on white).
  Headings: h1 name → h2 sections (these feed the TOC) → h3 entries (data-toc-skip).
{% endcomment %}
{%- assign cv_name = page.title -%}
{%- for cv_entry in site.data.cv -%}
  {%- if cv_entry.placement == 'header' and cv_entry.type == 'map' -%}
    {%- for item in cv_entry.contents -%}
      {%- if item.name == 'Full Name' %}{% assign cv_name = item.value %}{% endif -%}
    {%- endfor -%}
  {%- endif -%}
{%- endfor -%}

<div class="post cv-doc">
  <header class="post-header cv-head">
    <p class="kicker">{{ page.kicker | default: 'Curriculum vitae' }}</p>
    <div class="cv-head__top">
      <h1 class="post-title">{{ cv_name }}</h1>
      <button type="button" class="xw-btn xw-btn--secondary cv-print" onclick="window.print()">Print / Save as PDF</button>
    </div>
    {% if site.footer_identity %}
      <p class="post-description">
        {{- site.footer_identity.position -}}
        {%- if site.footer_identity.affiliation %}, {{ site.footer_identity.affiliation }}{% endif -%}
      </p>
    {% endif %}

    {% for cv_entry in site.data.cv %}
      {% if cv_entry.placement == 'header' %}
        {% if cv_entry.type == 'map' %}
          <dl class="cv-contact">
            {% for item in cv_entry.contents %}
              {% if item.name == 'Full Name' %}{% continue %}{% endif %}
              <div class="cv-contact__item">
                <dt>{{ item.name }}</dt>
                <dd>
                  {%- if item.name == 'Email' -%}
                    <a href="mailto:{{ item.value }}">{{ item.value }}</a>
                  {%- elsif item.name == 'Phone' -%}
                    <a href="tel:{{ item.value | remove: ' ' | remove: '(' | remove: ')' | remove: '-' }}">{{ item.value }}</a>
                  {%- else -%}
                    {{ item.value }}
                  {%- endif -%}
                </dd>
              </div>
            {% endfor %}
          </dl>
        {% elsif cv_entry.type == 'list' %}
          <ul class="cv-summary" aria-label="{{ cv_entry.title }}">
            {% for item in cv_entry.contents %}
              <li>{{ item }}</li>
            {% endfor %}
          </ul>
        {% endif %}
      {% endif %}
    {% endfor %}
  </header>

  <article class="cv-body">
    {% for entry in site.data.cv %}
      {% if entry.placement == 'header' %}{% continue %}{% endif %}
      {% assign section_id = entry.title | slugify %}
      <section class="cv-section cv-section--{{ entry.type }}" aria-labelledby="{{ section_id }}">
        <div class="cv-section__head">
          <h2 class="cv-section__title" id="{{ section_id }}">{{ entry.title }}</h2>
          {% if entry.link %}
            <a class="text-link cv-section__link" href="{{ entry.link | relative_url }}">
              {{- entry.link_label | default: 'More' }}
              {% include icon.liquid name="arrow-right" -%}
            </a>
          {% endif %}
        </div>
        {% case entry.type %}
          {% when 'time_table' %}
            {% include cv/time_table.liquid %}
          {% when 'map' %}
            {% include cv/map.liquid %}
          {% when 'list' %}
            {% include cv/list.liquid %}
          {% when 'nested_list' %}
            {% include cv/nested_list.liquid %}
          {% when 'list_groups' %}
            {% include cv/list_groups.liquid %}
          {% when 'publications' %}
            {% include cv/publications.liquid %}
          {% when 'teaching' %}
            {% include cv/teaching.liquid %}
          {% when 'mentoring' %}
            {% include cv/mentoring.liquid %}
          {% else %}
            <div class="cv-block">{{ entry.contents }}</div>
        {% endcase %}
      </section>
    {% endfor %}
  </article>
</div>
