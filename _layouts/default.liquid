<!doctype html>
<html lang="{{ site.lang }}" class="no-js">
  <!-- Head -->
  <head>
    <script>
      document.documentElement.classList.replace('no-js', 'js');
    </script>
    {% if page.redirect %}
      {% if page.redirect == true %}
        {% assign redirect = site.baseurl | append: '/' %}
      {% elsif page.redirect contains '://' %}
        {% assign redirect = page.redirect %}
      {% else %}
        {% assign redirect = page.redirect | relative_url %}
      {% endif %}
      <meta http-equiv="refresh" content="0; url={{ redirect }}">
    {% endif %}
    {% include head.liquid %}
  </head>

  <!-- Body -->
  <body class="{% if site.navbar_fixed %}fixed-top-nav{% endif %} {% unless site.footer_fixed %}sticky-bottom-footer{% endunless %}">
    <a class="skip-link" href="#main-content">Skip to content</a>

    <!-- Header -->
    {% include header.liquid %}

    <!-- Content -->
    {% comment %}
      Container width is explicit: `layout_width: wide` in a page's (or layout's) front
      matter gives the 1120px index/home canvas; everything else uses the reading width.
      `layout` here is the merged front matter of the whole layout chain.
    {% endcomment %}
    {% assign layout_width = page.layout_width | default: layout.layout_width %}
    <main id="main-content" class="site-main container{% if layout_width == 'wide' %} container--wide{% endif %}" tabindex="-1">
      {% if page.redirect %}
        {% comment %} For browsers that block the meta refresh above {% endcomment %}
        <p class="redirect-notice">
          This page has moved to <a href="{{ redirect }}">{{ redirect }}</a>.
        </p>
      {% endif %}
      {% if page.toc and page.toc.sidebar %}
        {% if page.toc.sidebar == 'right' %}
          <div class="row">
            <!-- main content area -->
            {% if page.toc.breakpoint == 'lg' %}
              <div class="col-12 col-lg-9">{{ content }}</div>
            {% else %}
              <div class="col-sm-9">{{ content }}</div>
            {% endif %}
            <!-- sidebar, which will move to the top on a small screen -->
            {% if page.toc.breakpoint == 'lg' %}
              <div class="d-none d-lg-block col-lg-3">
                <nav id="toc-sidebar" class="sticky-top" aria-label="On this page"></nav>
              </div>
            {% else %}
              <div class="col-sm-3">
                <nav id="toc-sidebar" class="sticky-top" aria-label="On this page"></nav>
              </div>
            {% endif %}
          </div>
        {% else %}
          <div class="row">
            <!-- sidebar, which will move to the top on a small screen -->
            <div class="col-sm-3">
              <nav id="toc-sidebar" class="sticky-top" aria-label="On this page"></nav>
            </div>
            <!-- main content area -->
            <div class="col-sm-9">{{ content }}</div>
          </div>
        {% endif %}
      {% else %}
        {{ content }}
      {% endif %}
    </main>

    <!-- Footer -->
    {% include footer.liquid %}

    <!-- JavaScripts -->
    {% include scripts.liquid %}
  </body>
</html>
