---
layout: default
---
{% if page._styles %}
  <!-- Page/Post style -->
  <style type="text/css">
    {{ page._styles }}
  </style>
{% endif %}

<div class="post">
  <header class="post-header">
    {% if page.kicker %}
      <p class="kicker">{{ page.kicker }}</p>
    {% endif %}
    {% comment %} <wbr> lets slash-joined titles ("Publications/Presentations") wrap on phones {% endcomment %}
    <h1 class="post-title">{{ page.title | replace: '/', '/<wbr>' }}</h1>
    {% if page.description and page.description != '' %}
      <p class="post-description">{{ page.description }}</p>
    {% endif %}
  </header>

  <article>
    {{ content }}
  </article>

  {% if page.related_publications %}
    <h2>References</h2>
    <div class="publications">
      {% bibliography --cited_in_order %}
    </div>
    <script src="{{ '/assets/js/abstract-modal.js' | relative_url | bust_file_cache }}" defer></script>
  {% endif %}

  {% if site.giscus and page.giscus_comments %}
    {% include giscus.liquid %}
  {% endif %}
</div>
