---
layout: default
---
{% comment %}
  Article layout for blog posts (_posts) and news items (_news).
  Header: mono kicker (section · category, linked), serif title, dek
  (description), mono meta (date · reading time), topic tags. Body: .prose
  measure. Footer: related posts (blog), then "All news/posts" and
  older/newer links. The tag/category/year archive links that used to sit in
  the meta line are kept as the tag row and the kicker links.
{% endcomment %}
{% assign url_beginning = page.url | slice: 0, 6 %}
{% assign is_blog = false %}
{% if url_beginning == '/blog/' %}{% assign is_blog = true %}{% endif %}
{% assign is_news = false %}
{% if page.collection == 'news' %}{% assign is_news = true %}{% endif %}
{% assign year = page.date | date: '%Y' %}
{% assign word_count = content | strip_html | number_of_words %}
{% assign read_time = word_count | plus: 179 | divided_by: 180 %}

{% if page._styles %}
  <!-- Page/Post style -->
  <style type="text/css">
    {{ page._styles }}
  </style>
{% endif %}

<div class="post post-article">
  <header class="post-header article-head">
    <p class="kicker">
      {% if is_news %}
        <a href="{{ '/news/' | relative_url }}">News</a>
        {%- if page.category %}<span aria-hidden="true">·</span><span>{{ page.category }}</span>{% endif %}
      {% elsif is_blog %}
        <a href="{{ '/blog/' | relative_url }}">Blog</a>
        {%- for category in page.categories -%}
          {%- assign category_label = category | replace: '-', ' ' | capitalize -%}
          {%- for taxonomy_category in site.data.blog_taxonomy.categories -%}
            {%- if taxonomy_category.key == category %}{% assign category_label = taxonomy_category.label %}{% endif -%}
          {%- endfor -%}
          <span aria-hidden="true">·</span><a href="{{ category | slugify | prepend: '/blog/category/' | append: '/' | relative_url }}">{{ category_label }}</a>
        {%- endfor -%}
      {% else %}
        {{ page.kicker | default: 'Article' }}
      {% endif %}
    </p>
    <h1 class="post-title">
      {% if page.redirect %}
        <a href="{{ page.redirect }}" target="_blank" rel="noopener noreferrer">{{ page.title }}</a>
      {% else %}
        {{ page.title }}
      {% endif %}
    </h1>
    {% if page.description and page.description != '' %}
      <p class="post-description">{{ page.description }}</p>
    {% endif %}
    <p class="post-meta">
      <time datetime="{{ page.date | date_to_xmlschema }}">{{ page.date | date: '%-d %B %Y' }}</time>
      {%- if page.last_updated %}<span aria-hidden="true"> · </span>Updated <time datetime="{{ page.last_updated | date_to_xmlschema }}">{{ page.last_updated | date: '%-d %B %Y' }}</time>{% endif -%}
      {%- if is_blog %}<span aria-hidden="true"> · </span>{{ read_time }} min read{% endif -%}
      {%- if page.author %}<span aria-hidden="true"> · </span>{{ page.author }}{% endif -%}
      {%- if page.meta %}<span aria-hidden="true"> · </span>{{ page.meta }}{% endif -%}
    </p>
    {% if is_blog %}
      <ul class="article-tags" aria-label="Archives">
        <li>
          <a class="tag" href="{{ year | prepend: '/blog/' | append: '/' | relative_url }}"><span class="sr-only">Posts from </span>{{ year }}</a>
        </li>
        {% for tag in page.tags %}
          <li>
            <a class="tag" href="{{ tag | slugify | prepend: '/blog/tag/' | append: '/' | relative_url }}"><span class="sr-only">Tag: </span>{{ tag }}</a>
          </li>
        {% endfor %}
      </ul>
    {% endif %}
  </header>

  <article class="post-content">
    {% if page.toc and page.toc.beginning %}
      <nav id="table-of-contents" class="article-toc" aria-label="Contents">
        {% toc %}
      </nav>
    {% endif %}
    <div id="markdown-content" class="prose">
      {{ content }}
    </div>
  </article>

  {% if page.citation %}
    {% include citation.liquid %}
  {% endif %}

  {% if page.related_publications %}
    <h2>References</h2>
    <div class="publications">
      {% bibliography --group_by none --cited_in_order %}
    </div>
    <script src="{{ '/assets/js/abstract-modal.js' | relative_url | bust_file_cache }}" defer></script>
  {% endif %}

  {% if site.related_blog_posts and site.related_blog_posts.enabled %}
    {% if page.related_posts == null or page.related_posts %}
      {% include related_posts.liquid %}
    {% endif %}
  {% endif %}

  {% if is_news or is_blog %}
    {% if is_news %}
      {% assign index_url = '/news/' %}
      {% assign index_label = 'All news' %}
    {% else %}
      {% assign index_url = '/blog/' %}
      {% assign index_label = 'All posts' %}
    {% endif %}
    <nav class="article-nav" aria-label="{% if is_news %}More news{% else %}More posts{% endif %}">
      <a class="text-link article-nav__all" href="{{ index_url | relative_url }}">
        {%- include icon.liquid name="arrow-right" class="icon--flip" %}
        {{ index_label -}}
      </a>
      {% if page.previous or page.next %}
        <ul class="article-nav__pager">
          {% if page.previous %}
            <li>
              <a class="article-nav__link" href="{{ page.previous.url | relative_url }}" rel="prev">
                <span class="article-nav__dir">Older</span>
                <span class="article-nav__title">{{ page.previous.title }}</span>
              </a>
            </li>
          {% endif %}
          {% if page.next %}
            <li class="article-nav__next">
              <a class="article-nav__link" href="{{ page.next.url | relative_url }}" rel="next">
                <span class="article-nav__dir">Newer</span>
                <span class="article-nav__title">{{ page.next.title }}</span>
              </a>
            </li>
          {% endif %}
        </ul>
      {% endif %}
    </nav>
  {% endif %}

  {% if site.disqus_shortname and page.disqus_comments %}
    {% include disqus.liquid %}
  {% endif %}
  {% if site.giscus and page.giscus_comments %}
    {% include giscus.liquid %}
  {% endif %}
</div>
