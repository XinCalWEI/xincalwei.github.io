---
layout: page
---
<!--
  People rows in the site's card language: grouped by program, each person
  a photo + name + meta + bio row. Sections come from page.profiles entries
  with section_title; people entries follow their section.
-->
<div class="post about tm-people">
  {% assign open = false %}
  {% for profile in page.profiles %}
    {% if profile.section_title %}
      {% if open %}
        </ul>
        </div>
      {% endif %}
      <h2 class="people-sec">
        {% if profile.section_url %}
          <a href="{{ profile.section_url }}" target="_blank" rel="noopener noreferrer">
            {{ profile.section_title }}
            <i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i>
            <span class="sr-only">(opens in a new tab)</span>
          </a>
        {% else %}
          {{ profile.section_title }}
        {% endif %}
      </h2>
      <div class="cardlist">
        <ul class="people">
          {% assign open = true %}
    {% else %}
      {% unless open %}
        <div class="cardlist">
          <ul class="people">
            {% assign open = true %}
      {% endunless %}
      <li class="person">
        {% if profile.image %}
          <div class="person__photo">
            {% assign profile_image_path = profile.image | prepend: 'assets/img/' %}
            {% include figure.liquid loading="eager" path=profile_image_path sizes="220px" alt=profile.name %}
          </div>
        {% endif %}
        <div class="person__body">
          <h3 class="person__name">{{ profile.name }}</h3>
          {% if profile.more_info %}
            <div class="person__meta">{{ profile.more_info }}</div>
          {% endif %}
          {% if profile.content %}
            {% capture profile_content %}{% include_relative {{ profile.content }} %}{% endcapture %}
            <div class="person__bio">{{ profile_content | markdownify }}</div>
          {% endif %}
        </div>
      </li>
    {% endif %}
  {% endfor %}
  {% if open %}
    </ul>
    </div>
  {% endif %}
</div>
